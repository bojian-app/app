<?xml version="1.0" encoding="utf-8"?>
<!-- 广告素材（视频/图片）仍存在 http 资源，Android 9+ 默认禁止明文请求，这里放开广告域名。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
