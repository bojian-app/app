+func TestBenefitPublicSourcesValidation(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		edit func(*benefitContent)
+	}{
+		{"missing", func(in *benefitContent) { in.Sources = nil }},
+		{"partial", func(in *benefitContent) { in.Benefits["salary"] = "招聘公告所载薪资" }},
+		{"unmatched", func(in *benefitContent) { in.Sources = map[string]benefitSource{"salary": in.Sources["leave"]} }},
+		{"extra", func(in *benefitContent) { in.Sources["salary"] = in.Sources["leave"] }},
+		{"missing publisher", func(in *benefitContent) {
+			source := in.Sources["leave"]
+			source.Publisher = ""
+			in.Sources["leave"] = source
+		}},
+		{"internal URL", func(in *benefitContent) {
+			source := in.Sources["leave"]
+			source.URL = "http://hr.company.internal/benefits"
+			in.Sources["leave"] = source
+		}},
+		{"invalid date", func(in *benefitContent) {
+			source := in.Sources["leave"]
+			source.PublishedOn = "2026-02-30"
+			in.Sources["leave"] = source
+		}},
+		{"future date", func(in *benefitContent) {
+			source := in.Sources["leave"]
+			source.PublishedOn = time.Now().Add(48 * time.Hour).Format(time.DateOnly)
+			in.Sources["leave"] = source
+		}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			in := testBenefitContent()
+			test.edit(&in)
+			if err := in.validate(); err != nil {
+				t.Fatal("basic validation must allow sources awaiting review", err)
+			}
+			if err := in.validatePublicSources(); err == nil {
+				t.Fatal("invalid public source accepted")
+			}
+		})
+	}
+	in := testBenefitContent()
+	source := in.Sources["leave"]
+	source.URL, source.Publisher, source.PublishedOn = " https://careers.company.cn/jobs/123 ", " 企业官网 ", ""
+	in.Sources["leave"] = source
+	if err := in.validate(); err != nil {
+		t.Fatal(err)
+	}
+	if err := in.validatePublicSources(); err != nil {
+		t.Fatal(err)
+	}
+	if in.Sources["leave"].Publisher != "企业官网" || in.Sources["leave"].URL != "https://careers.company.cn/jobs/123" {
+		t.Fatal("source fields not normalized")
+	}
+}
