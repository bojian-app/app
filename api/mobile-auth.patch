+package httpapi
+
+import (
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/wenlng/go-captcha-assets/resources/imagesv2"
+	"github.com/wenlng/go-captcha-assets/resources/tiles"
+	"github.com/wenlng/go-captcha/v2/base/option"
+	"github.com/wenlng/go-captcha/v2/rotate"
+	"github.com/wenlng/go-captcha/v2/slide"
+)
+
+var slideOnce sync.Once
+var slideReady slide.Captcha
+var slideError error
+
+func slideCaptcha() (slide.Captcha, error) {
+	slideOnce.Do(func() {
+		backgrounds, err := imagesv2.GetImages()
+		if err != nil {
+			slideError = err
+			return
+		}
+		tileAssets, err := tiles.GetTiles()
+		if err != nil {
+			slideError = err
+			return
+		}
+		graphs := make([]*slide.GraphImage, 0, len(tileAssets))
+		for _, tile := range tileAssets {
+			graphs = append(graphs, &slide.GraphImage{
+				OverlayImage: tile.OverlayImage,
+				ShadowImage:  tile.ShadowImage,
+				MaskImage:    tile.MaskImage,
+			})
+		}
+		builder := slide.NewBuilder(
+			slide.WithImageSize(option.Size{Width: 320, Height: 180}),
+			slide.WithRangeGraphSize(option.RangeVal{Min: 44, Max: 52}),
+			slide.WithRangeGraphAnglePos([]option.RangeVal{{Min: 0, Max: 0}}),
+		)
+		builder.SetResources(slide.WithBackgrounds(backgrounds), slide.WithGraphImages(graphs))
+		slideReady = builder.Make()
+	})
+	return slideReady, slideError
+}
+
+func (s *Server) createSlideCaptcha(w http.ResponseWriter, r *http.Request) {
+	capt, err := slideCaptcha()
+	if err != nil {
+		Failure(w, r, 503, "CAPTCHA_UNAVAILABLE", "验证码服务暂不可用", nil)
+		return
+	}
+	data, err := capt.Generate()
+	if err != nil || data == nil || data.GetData() == nil {
+		Failure(w, r, 503, "CAPTCHA_UNAVAILABLE", "验证码服务暂不可用", nil)
+		return
+	}
+	block := data.GetData()
+	master, err := data.GetMasterImage().ToBase64()
+	if err != nil {
+		Failure(w, r, 503, "CAPTCHA_UNAVAILABLE", "验证码服务暂不可用", nil)
+		return
+	}
+	piece, err := data.GetTileImage().ToBase64()
+	if err != nil {
+		Failure(w, r, 503, "CAPTCHA_UNAVAILABLE", "验证码服务暂不可用", nil)
+		return
+	}
+	id := newSecret(18)
+	maxX := 320 - block.Width
+	// The solution stays server-side and is consumed once, like rotation challenges.
+	expected := fmt.Sprintf("SLIDE:%d:%d", block.X, maxX)
+	if err := s.redis.Set(r.Context(), "captcha:"+id, expected, 5*time.Minute).Err(); err != nil {
+		Failure(w, r, 503, "REDIS_UNAVAILABLE", "验证码服务暂不可用", nil)
+		return
+	}
+	Success(w, r, http.StatusCreated, map[string]any{
+		"id": id, "kind": "SLIDE", "master_image_data_url": master,
+		"thumb_image_data_url": piece, "piece_y": block.Y, "max_x": maxX,
+		"expires_at": time.Now().Add(5 * time.Minute).UTC().Format(time.RFC3339),
+	})
+}
+
+func validCaptchaAnswer(expected string, angle, x *int) bool {
+	if strings.HasPrefix(expected, "SLIDE:") {
+		parts := strings.Split(expected, ":")
+		if len(parts) != 3 || x == nil {
+			return false
+		}
+		target, err := strconv.Atoi(parts[1])
+		if err != nil {
+			return false
+		}
+		maxX, err := strconv.Atoi(parts[2])
+		if err != nil {
+			return false
+		}
+		if *x < 0 || *x > maxX {
+			return false
+		}
+		return *x >= target-4 && *x <= target+4
+	}
+	target, err := strconv.Atoi(strings.TrimSpace(expected))
+	return err == nil && angle != nil && *angle >= 0 && *angle <= 720 &&
+		rotate.Validate(*angle, target, captchaAnglePadding)
+}
