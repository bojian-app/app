+package httpapi
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestMobileAndDesktopDeviceHeaders(t *testing.T) {
+	for _, platform := range []string{"ANDROID", "IOS", "WINDOWS", "MACOS", "android"} {
+		r := httptest.NewRequest("POST", "/", nil)
+		r.Header.Set("X-Device-Id", "test-device")
+		r.Header.Set("X-Platform", platform)
+		r.Header.Set("X-App-Version", "1.0.0")
+		if _, _, _, ok := deviceHeaders(httptest.NewRecorder(), r); !ok {
+			t.Fatalf("rejected %s", platform)
+		}
+	}
+	for _, invalid := range []string{"WEB", "", "ANDROID_WITHOUT_DEVICE"} {
+		r := httptest.NewRequest("POST", "/", nil)
+		r.Header.Set("X-Platform", invalid)
+		r.Header.Set("X-App-Version", "1.0.0")
+		if _, _, _, ok := deviceHeaders(httptest.NewRecorder(), r); ok {
+			t.Fatal("accepted invalid headers")
+		}
+	}
+}
+func TestSlideCaptchaValidation(t *testing.T) {
+	capt, err := slideCaptcha()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 10; i++ {
+		data, err := capt.Generate()
+		if err != nil {
+			t.Fatal(err)
+		}
+		block := data.GetData()
+		if block.X <= 4 || block.X > 320-block.Width || block.Y < 0 || block.Y+block.Height > 180 {
+			t.Fatalf("bad geometry: %+v", block)
+		}
+		master, err := data.GetMasterImage().ToBase64()
+		if err != nil || !strings.HasPrefix(master, "data:image/jpeg;base64,") {
+			t.Fatal("invalid master")
+		}
+		piece, err := data.GetTileImage().ToBase64()
+		if err != nil || !strings.HasPrefix(piece, "data:image/png;base64,") {
+			t.Fatal("invalid piece")
+		}
+	}
+	x := 160
+	wrong := 180
+	negative := -1
+	large := 300
+	angle := 200
+	if !validCaptchaAnswer("SLIDE:160:270", nil, &x) {
+		t.Fatal("valid answer rejected")
+	}
+	for _, value := range []*int{nil, &wrong, &negative, &large} {
+		if validCaptchaAnswer("SLIDE:160:270", &angle, value) {
+			t.Fatal("invalid slide answer accepted")
+		}
+	}
+	if !validCaptchaAnswer("160", &angle, nil) {
+		t.Fatal("rotation compatibility broken")
+	}
+	if validCaptchaAnswer("160", nil, &x) {
+		t.Fatal("slide answer accepted for rotation")
+	}
+}
+
+func TestInvalidClientHeadersRejectedBeforeCodeConsumption(t *testing.T) {
+	r := httptest.NewRequest("POST", "/api/v1/auth/phone/exchange", strings.NewReader(`{"phone":"13812345678","code":"000000"}`))
+	w := httptest.NewRecorder()
+	(&Server{}).phoneExchange(w, r)
+	if w.Code != 400 || !strings.Contains(w.Body.String(), "CLIENT_HEADERS_REQUIRED") {
+		t.Fatalf("bad response: %d %s", w.Code, w.Body.String())
+	}
+}
