+
+func TestDeviceMetadataHeader(t *testing.T) {
+	for _, tc := range []struct{ raw, want string }{
+		{"OPPO%20PJD110", "OPPO PJD110"}, {"iPhone17%2C1", "iPhone17,1"}, {"bad%xx", ""}, {"%0Ainjected", ""}, {"", ""}, {strings.Repeat("a", 129), ""},
+	} {
+		r := httptest.NewRequest("GET", "/", nil)
+		r.Header.Set("X-Device-Model", tc.raw)
+		if got := deviceMetadataHeader(r, "X-Device-Model", 128); got != tc.want {
+			t.Fatalf("got %q want %q", got, tc.want)
+		}
+	}
+}
