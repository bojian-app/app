+
+// Metadata is optional for older clients, bounded, and never used as device identity.
+func deviceMetadataHeader(r *http.Request, key string, limit int) string {
+	value, err := url.PathUnescape(r.Header.Get(key))
+	if err != nil || !utf8.ValidString(value) || len(value) > limit || strings.IndexFunc(value, unicode.IsControl) >= 0 {
+		return ""
+	}
+	return strings.TrimSpace(value)
+}
