+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"log/slog"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func benefitTestDB(t *testing.T) *pgxpool.Pool {
+	t.Helper()
+	dsn := os.Getenv("BENEFITS_TEST_DATABASE_URL")
+	if dsn == "" {
+		t.Skip("isolated local database required")
+	}
+	u, e := url.Parse(dsn)
+	if e != nil || u.Hostname() != "127.0.0.1" {
+		t.Fatal("local database required")
+	}
+	ctx := context.Background()
+	root, e := pgxpool.New(ctx, dsn)
+	if e != nil {
+		t.Fatal(e)
+	}
+	schema := fmt.Sprintf("benefits_%d", time.Now().UnixNano())
+	if _, e = root.Exec(ctx, "CREATE SCHEMA "+schema); e != nil {
+		t.Fatal(e)
+	}
+	cfg, _ := pgxpool.ParseConfig(dsn)
+	cfg.ConnConfig.RuntimeParams["search_path"] = schema
+	db, e := pgxpool.NewWithConfig(ctx, cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { db.Close(); root.Exec(ctx, "DROP SCHEMA "+schema+" CASCADE"); root.Close() })
+	_, e = db.Exec(ctx, `CREATE TABLE users(id bigint PRIMARY KEY);INSERT INTO users VALUES(1),(2);CREATE TABLE admin_principals(id bigint PRIMARY KEY);INSERT INTO admin_principals VALUES(1);CREATE TABLE files(id bigint PRIMARY KEY,owner_id bigint,purpose text,status text,object_key text,original_name text,content_type text,size_bytes bigint,deleted_at timestamptz);INSERT INTO files VALUES(11,1,'EMPLOYMENT_PROOF','READY','private-proof','proof.pdf','application/pdf',10,NULL),(12,1,'BENEFIT_EVIDENCE','READY','private-evidence','benefit.png','image/png',10,NULL),(13,2,'EMPLOYMENT_PROOF','READY','other-private','other.pdf','application/pdf',10,NULL),(14,1,'AVATAR','READY','avatar','avatar.png','image/png',10,NULL);CREATE TABLE notifications(id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,user_id bigint,type text,subject_type text,subject_id bigint,payload_safe_jsonb jsonb);`)
+	if e != nil {
+		t.Fatal(e)
+	}
+	migration, e := os.ReadFile("../database/migrations/041_company_benefits.sql")
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = db.Exec(ctx, string(migration)); e != nil {
+		t.Fatal(e)
+	}
+	return db
+}
+func testBenefitContent() benefitContent {
+	return benefitContent{CompanyName: "隔离测试企业", Province: "广东省", City: "广州市", Industry: "软件", JobScope: "正式员工", ValidAsOf: "2026-10-10", Benefits: map[string]string{"leave": "双休"}}
+}
+
+func TestCompanyBenefitsWorkflow(t *testing.T) {
+	db := benefitTestDB(t)
+	s := &Server{db: db, logger: slog.Default()}
+	ctx := context.Background()
+	input := benefitSubmissionInput{Content: testBenefitContent(), Employment: []int64{11}, Evidence: []int64{12}}
+	call := func(uid int64, method, path, key string, in benefitSubmissionInput, want int) map[string]any {
+		t.Helper()
+		raw, _ := json.Marshal(in)
+		r := httptest.NewRequest(method, path, strings.NewReader(string(raw)))
+		r = r.WithContext(context.WithValue(r.Context(), userIDKey, uid))
+		r.Header.Set("Idempotency-Key", key)
+		r.SetPathValue("id", "1")
+		w := httptest.NewRecorder()
+		s.writeBenefitSubmission(w, r)
+		if w.Code != want {
+			t.Fatalf("%s got %d want %d: %s", method, w.Code, want, w.Body.String())
+		}
+		var v map[string]any
+		json.Unmarshal(w.Body.Bytes(), &v)
+		return v
+	}
+	key := "benefits-request-0001"
+	call(1, "POST", "/api/v1/company-benefit-submissions", key, input, 200)
+	call(1, "POST", "/api/v1/company-benefit-submissions", key, input, 200)
+	var n int
+	db.QueryRow(ctx, `SELECT count(*) FROM company_benefit_submissions`).Scan(&n)
+	if n != 1 {
+		t.Fatal("duplicate submission")
+	}
+	changed := input
+	changed.Evidence = []int64{14}
+	call(1, "POST", "/", "benefits-request-0002", changed, 422)
+	changed = input
+	changed.Employment = []int64{13}
+	call(1, "POST", "/", "benefits-request-0003", changed, 422)
+	changed = input
+	changed.Employment = nil
+	call(1, "POST", "/", "benefits-request-0004", changed, 422)
+	changed = input
+	changed.Revision = 1
+	call(1, "POST", "/", key, changed, 409)
+	read := func(uid int64, want int) {
+		r := httptest.NewRequest("GET", "/", nil)
+		r.SetPathValue("id", "1")
+		r = r.WithContext(context.WithValue(r.Context(), userIDKey, uid))
+		w := httptest.NewRecorder()
+		s.getMyBenefitSubmission(w, r)
+		if w.Code != want {
+			t.Fatalf("owner read %d: %s", w.Code, w.Body.String())
+		}
+	}
+	read(2, 404)
+	read(1, 200)
+	input.Revision = 1
+	call(1, "PATCH", "/", "", input, 409)
+	db.Exec(ctx, `UPDATE company_benefit_submissions SET status='NEEDS_MORE',revision=2 WHERE id=1`)
+	call(1, "PATCH", "/", "", input, 409)
+	input.Revision = 2
+	call(2, "PATCH", "/", "", input, 422)
+	call(1, "PATCH", "/", "", input, 200)
+	var status string
+	var rev int
+	db.QueryRow(ctx, `SELECT status,revision FROM company_benefit_submissions WHERE id=1`).Scan(&status, &rev)
+	if status != "PENDING" || rev != 3 {
+		t.Fatal("resubmission did not transition")
+	}
+	db.Exec(ctx, `INSERT INTO company_benefits(company_name,province,city,job_scope,valid_as_of,benefits_jsonb) VALUES('公开测试企业','广东省','广州市','员工','2026-10-10','{"leave":"双休"}')`)
