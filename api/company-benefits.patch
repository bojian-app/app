+// VerifyPrivateUpload confirms that private evidence exists with the expected size.
+func (k *Kodo) VerifyPrivateUpload(ctx context.Context, key, mime string, size int64) error {
+	if !k.private {
+		return errors.New("private evidence storage is required")
+	}
+	info, err := k.objects.Object(key).Stat().Call(ctx)
+	if err != nil {
+		return errors.New("uploaded evidence is not available")
+	}
+	if info.Size != size || strings.ToLower(info.MimeType) != mime {
+		return errors.New("uploaded evidence does not match upload session")
+	}
+	return nil
+}
