+package httpapi
+
+import (
+	"errors"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+type benefitContent struct {
+	CompanyName  string            `json:"company_name"`
+	Province     string            `json:"province"`
+	City         string            `json:"city"`
+	Industry     string            `json:"industry"`
+	JobScope     string            `json:"job_scope"`
+	ValidAsOf    string            `json:"valid_as_of"`
+	Benefits     map[string]string `json:"benefits"`
+	OfficialNote string            `json:"official_note"`
+}
+
+var benefitCategories = map[string]bool{"salary": true, "insurance": true, "hours": true, "leave": true, "bonus": true, "allowance": true, "growth": true, "other": true}
+
+func (in *benefitContent) validate() error {
+	in.CompanyName = strings.TrimSpace(in.CompanyName)
+	in.Province = strings.TrimSpace(in.Province)
+	in.City = strings.TrimSpace(in.City)
+	in.Industry = strings.TrimSpace(in.Industry)
+	in.JobScope = strings.TrimSpace(in.JobScope)
+	in.OfficialNote = strings.TrimSpace(in.OfficialNote)
+	for _, field := range []struct {
+		value    string
+		min, max int
+	}{{in.CompanyName, 2, 120}, {in.Province, 1, 40}, {in.City, 1, 40}, {in.Industry, 0, 60}, {in.JobScope, 1, 100}, {in.OfficialNote, 0, 1500}} {
+		n := utf8.RuneCountInString(field.value)
+		if n < field.min || n > field.max {
+			return errors.New("请填写完整的企业名称、地区和适用岗位，内容不要超过字数限制")
+		}
+	}
+	if _, err := time.Parse(time.DateOnly, in.ValidAsOf); err != nil {
+		return errors.New("请填写待遇对应日期（YYYY-MM-DD）")
+	}
+	if len(in.Benefits) == 0 || len(in.Benefits) > 8 {
+		return errors.New("请至少填写一项福利待遇")
+	}
+	for key, value := range in.Benefits {
+		value = strings.TrimSpace(value)
+		if !benefitCategories[key] || value == "" || utf8.RuneCountInString(value) > 2000 {
+			return errors.New("福利内容无效，每项最多2000字")
+		}
+		in.Benefits[key] = value
+	}
+	return nil
+}
--- a/internal/httpapi/company_benefits.go
+++ b/internal/httpapi/company_benefits.go
@@ -0,0 +1,316 @@
+package httpapi
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Public records contain only information curated by officials. Proofs never join this query.
+const benefitPublicColumns = `id,company_name,province,city,industry,job_scope,valid_as_of::text,benefits_jsonb,official_note,revision,verified_at`
+
+func scanBenefit(row interface{ Scan(...any) error }) (map[string]any, error) {
+	var id, revision int64
+	var content benefitContent
+	var raw []byte
+	var verified time.Time
+	err := row.Scan(&id, &content.CompanyName, &content.Province, &content.City, &content.Industry, &content.JobScope, &content.ValidAsOf, &raw, &content.OfficialNote, &revision, &verified)
+	if err != nil {
+		return nil, err
+	}
+	if err = json.Unmarshal(raw, &content.Benefits); err != nil {
+		return nil, err
+	}
+	return map[string]any{"id": id, "content": content, "revision": revision, "verified_at": verified}, nil
+}
+func (s *Server) listCompanyBenefits(w http.ResponseWriter, r *http.Request) {
+	q := strings.TrimSpace(r.URL.Query().Get("query"))
+	city := strings.TrimSpace(r.URL.Query().Get("city"))
+	industry := strings.TrimSpace(r.URL.Query().Get("industry"))
+	if len(q) > 360 || len(city) > 120 || len(industry) > 180 {
+		Failure(w, r, 422, "INVALID_ARGUMENT", "搜索内容过长", nil)
+		return
+	}
+	cursor, _ := strconv.ParseInt(r.URL.Query().Get("cursor"), 10, 64)
+	limit := queryLimit(r, 20, 50)
+	// strpos treats wildcard characters literally.
+	rows, err := s.db.Query(r.Context(), `SELECT `+benefitPublicColumns+` FROM company_benefits WHERE status='PUBLISHED' AND ($1='' OR strpos(lower(company_name),lower($1))>0) AND ($2='' OR city=$2) AND ($3='' OR industry=$3) AND ($4::bigint=0 OR id<$4) ORDER BY id DESC LIMIT $5`, q, city, industry, cursor, limit+1)
+	if err != nil {
+		s.internal(w, r, "benefits list", err)
+		return
+	}
+	defer rows.Close()
+	items := []map[string]any{}
+	for rows.Next() {
+		item, e := scanBenefit(rows)
+		if e != nil {
+			s.internal(w, r, "benefits scan", e)
+			return
+		}
+		items = append(items, item)
+	}
+	if err = rows.Err(); err != nil {
+		s.internal(w, r, "benefits rows", err)
+		return
+	}
+	var next any
+	if len(items) > limit {
+		items = items[:limit]
+		next = items[limit-1]["id"]
+	}
+	Success(w, r, 200, map[string]any{"items": items, "next_cursor": next})
+}
+func (s *Server) getCompanyBenefit(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r, "id")
+	if !ok {
+		return
+	}
+	item, err := scanBenefit(s.db.QueryRow(r.Context(), `SELECT `+benefitPublicColumns+` FROM company_benefits WHERE id=$1 AND status='PUBLISHED'`, id))
+	if err == pgx.ErrNoRows {
+		Failure(w, r, 404, "NOT_FOUND", "企业尚未收录或已下架", nil)
+		return
+	}
+	if err != nil {
+		s.internal(w, r, "benefit detail", err)
+		return
+	}
+	Success(w, r, 200, item)
+}
+
+type benefitSubmissionInput struct {
+	CompanyID  *int64         `json:"company_id"`
+	Content    benefitContent `json:"content"`
+	Employment []int64        `json:"employment_file_ids"`
+	Evidence   []int64        `json:"evidence_file_ids"`
+	Revision   int64          `json:"revision"`
+}
+
+func validBenefitFiles(proof, evidence []int64) bool {
+	if len(proof) < 1 || len(proof) > 3 || len(evidence) < 1 || len(evidence) > 8 {
+		return false
+	}
+	seen := map[int64]bool{}
+	for _, list := range [][]int64{proof, evidence} {
+		for _, id := range list {
+			if id <= 0 || seen[id] {
+				return false
+			}
+			seen[id] = true
+		}
+	}
+	return true
+}
+func (s *Server) writeBenefitSubmission(w http.ResponseWriter, r *http.Request) {
+	var in benefitSubmissionInput
+	if err := decodeJSON(w, r, &in, 64<<10); err != nil {
+		Failure(w, r, 422, "INVALID_ARGUMENT", "提交内容格式无效", nil)
+		return
+	}
+	if err := in.Content.validate(); err != nil {
+		Failure(w, r, 422, "INVALID_ARGUMENT", err.Error(), nil)
+		return
+	}
+	// Officials alone may write a public note.
+	in.Content.OfficialNote = ""
+	if !validBenefitFiles(in.Employment, in.Evidence) {
+		Failure(w, r, 422, "PROOF_REQUIRED", "请提供1–3份在职证明和1–8份福利图片或视频", nil)
+		return
+	}
+	editing := r.Method == "PATCH"
+	var id int64
+	var ok bool
+	if editing {
+		id, ok = pathID(w, r, "id")
+		if !ok {
+			return
+		}
+	}
+	key := strings.TrimSpace(r.Header.Get("Idempotency-Key"))
+	if !editing && (len(key) < 16 || len(key) > 100) {
+		Failure(w, r, 422, "INVALID_ARGUMENT", "提交标识无效，请重试", nil)
+		return
+	}
+	raw, _ := json.Marshal(in.Content)
+	hashRaw, _ := json.Marshal(in)
+	hash := fmt.Sprintf("%x", sha256.Sum256(hashRaw))
+	owner := UserID(r.Context())
+	tx, err := s.db.Begin(r.Context())
+	if err != nil {
+		s.internal(w, r, "benefits begin", err)
+		return
+	}
+	defer tx.Rollback(r.Context())
+	if !editing {
+		var oldHash string
+		err = tx.QueryRow(r.Context(), `SELECT id,request_hash FROM company_benefit_submissions WHERE user_id=$1 AND request_key=$2`, owner, key).Scan(&id, &oldHash)
+		if err == nil {
+			if oldHash != hash {
+				Failure(w, r, 409, "IDEMPOTENCY_CONFLICT", "提交内容已变化，请重新提交", nil)
+				return
+			}
+			Success(w, r, 200, map[string]any{"id": id, "deduplicated": true})
+			return
+		}
+		if err != pgx.ErrNoRows {
+			s.internal(w, r, "benefits retry", err)
+			return
+		}
+	}
+	for _, group := range []struct {
+		ids     []int64
+		purpose string
+	}{{in.Employment, "EMPLOYMENT_PROOF"}, {in.Evidence, "BENEFIT_EVIDENCE"}} {
+		var count int
+		err = tx.QueryRow(r.Context(), `SELECT count(*) FROM files WHERE id=ANY($1) AND owner_id=$2 AND purpose=$3 AND status='READY' AND deleted_at IS NULL`, group.ids, owner, group.purpose).Scan(&count)
+		if err != nil {
+			s.internal(w, r, "benefits files", err)
+			return
+		}
+		if count != len(group.ids) {
+			Failure(w, r, 422, "FILES_INVALID", "材料尚未上传完成或不属于当前账号", nil)
+			return
+		}
+	}
+	if in.CompanyID != nil {
+		var exists bool
+		err = tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM company_benefits WHERE id=$1 AND status='PUBLISHED')`, *in.CompanyID).Scan(&exists)
+		if err != nil {
+			s.internal(w, r, "benefits company", err)
+			return
+		}
+		if !exists {
+			Failure(w, r, 404, "NOT_FOUND", "企业收录记录不存在", nil)
+			return
+		}
+	}
+	if editing {
+		var status string
+		var revision int64
+		err = tx.QueryRow(r.Context(), `SELECT status,revision FROM company_benefit_submissions WHERE id=$1 AND user_id=$2 FOR UPDATE`, id, owner).Scan(&status, &revision)
+		if err == pgx.ErrNoRows {
+			Failure(w, r, 404, "NOT_FOUND", "提交记录不存在", nil)
+			return
+		}
+		if err != nil {
+			s.internal(w, r, "benefits edit", err)
+			return
+		}
+		if revision != in.Revision || (status != "NEEDS_MORE" && status != "REJECTED") {
+			Failure(w, r, 409, "STATE_CONFLICT", "审核状态已变化，请刷新后再提交", nil)
+			return
+		}
+		_, err = tx.Exec(r.Context(), `UPDATE company_benefit_submissions SET company_id=$2,content_jsonb=$3,employment_file_ids=$4,evidence_file_ids=$5,status='PENDING',review_reason='',reviewed_at=NULL,updated_at=now(),revision=revision+1 WHERE id=$1`, id, in.CompanyID, raw, in.Employment, in.Evidence)
+	} else {
+		var insertedHash string
+		// A simultaneous retry waits for the first insert, then returns its existing ID.
+		err = tx.QueryRow(r.Context(), `INSERT INTO company_benefit_submissions(user_id,company_id,content_jsonb,employment_file_ids,evidence_file_ids,request_key,request_hash) VALUES($1,$2,$3,$4,$5,$6,$7) ON CONFLICT(user_id,request_key) DO UPDATE SET request_key=EXCLUDED.request_key RETURNING id,request_hash`, owner, in.CompanyID, raw, in.Employment, in.Evidence, key, hash).Scan(&id, &insertedHash)
+		if err == nil && insertedHash != hash {
+			Failure(w, r, 409, "IDEMPOTENCY_CONFLICT", "提交内容已变化，请重新提交", nil)
+			return
+		}
+	}
+	if err != nil {
+		s.internal(w, r, "benefits write", err)
+		return
+	}
+	if err = tx.Commit(r.Context()); err != nil {
+		s.internal(w, r, "benefits commit", err)
+		return
+	}
+	Success(w, r, 200, map[string]any{"id": id, "status": "PENDING"})
+}
+
+const benefitSubmissionColumns = `id,company_id,content_jsonb,employment_file_ids,evidence_file_ids,status,review_reason,revision,created_at,updated_at`
+
+func scanBenefitSubmission(row interface{ Scan(...any) error }) (map[string]any, error) {
+	var id, revision int64
+	var company *int64
+	var raw []byte
+	var proof, evidence []int64
+	var status, reason string
+	var created, updated time.Time
+	err := row.Scan(&id, &company, &raw, &proof, &evidence, &status, &reason, &revision, &created, &updated)
+	if err != nil {
+		return nil, err
+	}
+	var content benefitContent
+	if err = json.Unmarshal(raw, &content); err != nil {
+		return nil, err
+	}
+	return map[string]any{"id": id, "company_id": company, "content": content, "employment_file_ids": proof, "evidence_file_ids": evidence, "status": status, "review_reason": reason, "revision": revision, "created_at": created, "updated_at": updated}, nil
+}
+func (s *Server) listMyBenefitSubmissions(w http.ResponseWriter, r *http.Request) {
+	cursor, _ := strconv.ParseInt(r.URL.Query().Get("cursor"), 10, 64)
+	limit := queryLimit(r, 20, 50)
+	rows, err := s.db.Query(r.Context(), `SELECT `+benefitSubmissionColumns+` FROM company_benefit_submissions WHERE user_id=$1 AND ($2::bigint=0 OR id<$2) ORDER BY id DESC LIMIT $3`, UserID(r.Context()), cursor, limit+1)
+	if err != nil {
+		s.internal(w, r, "benefits mine", err)
+		return
+	}
+	defer rows.Close()
+	items := []map[string]any{}
+	for rows.Next() {
+		item, e := scanBenefitSubmission(rows)
+		if e != nil {
+			s.internal(w, r, "benefits mine scan", e)
+			return
+		}
+		items = append(items, item)
+	}
+	if err = rows.Err(); err != nil {
+		s.internal(w, r, "benefits mine rows", err)
+		return
+	}
+	var next any
+	if len(items) > limit {
+		items = items[:limit]
+		next = items[limit-1]["id"]
+	}
+	w.Header().Set("Cache-Control", "no-store")
+	Success(w, r, 200, map[string]any{"items": items, "next_cursor": next})
+}
+func (s *Server) getMyBenefitSubmission(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r, "id")
+	if !ok {
+		return
+	}
+	item, err := scanBenefitSubmission(s.db.QueryRow(r.Context(), `SELECT `+benefitSubmissionColumns+` FROM company_benefit_submissions WHERE id=$1 AND user_id=$2`, id, UserID(r.Context())))
+	if err == pgx.ErrNoRows {
+		Failure(w, r, 404, "NOT_FOUND", "提交记录不存在", nil)
+		return
+	}
+	if err != nil {
+		s.internal(w, r, "benefits own detail", err)
+		return
+	}
+	files := []map[string]any{}
+	ids := append(append([]int64{}, item["employment_file_ids"].([]int64)...), item["evidence_file_ids"].([]int64)...)
+	rows, err := s.db.Query(r.Context(), `SELECT id,purpose,original_name,content_type,size_bytes FROM files WHERE id=ANY($1) AND owner_id=$2 AND status='READY' AND deleted_at IS NULL`, ids, UserID(r.Context()))
+	if err != nil {
+		s.internal(w, r, "benefits own files", err)
+		return
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var fid, size int64
+		var purpose, name, mime string
+		if err = rows.Scan(&fid, &purpose, &name, &mime, &size); err != nil {
+			s.internal(w, r, "benefits files scan", err)
+			return
+		}
+		files = append(files, map[string]any{"id": fid, "purpose": purpose, "name": name, "content_type": mime, "size_bytes": size})
+	}
+	if err = rows.Err(); err != nil {
+		s.internal(w, r, "benefits files rows", err)
+		return
+	}
+	item["files"] = files
+	w.Header().Set("Cache-Control", "no-store")
+	Success(w, r, 200, item)
+}
