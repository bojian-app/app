@@ -0,0 +1,19 @@
+package httpapi
+
+import "testing"
+
+func TestTemplatePurchaseQuoteMatches(t *testing.T) {
+	price, revision := int64(80), int64(3)
+	if !templatePurchaseQuoteMatches(80, 3, &price, &revision) {
+		t.Fatal("matching confirmation rejected")
+	}
+	if templatePurchaseQuoteMatches(81, 3, &price, &revision) {
+		t.Fatal("changed price accepted")
+	}
+	if templatePurchaseQuoteMatches(80, 4, &price, &revision) {
+		t.Fatal("changed template accepted")
+	}
+	if !templatePurchaseQuoteMatches(80, 3, nil, nil) {
+		t.Fatal("legacy clients broken")
+	}
+}
