+package jobs
+
+import (
+	"archive/zip"
+	"bytes"
+	"image"
+	"image/png"
+	"io"
+	"strings"
+	"testing"
+)
+
+func TestDOCXPortraitIsEmbedded(t *testing.T) {
+	var b bytes.Buffer
+	w := zip.NewWriter(&b)
+	for name, content := range map[string]string{"[Content_Types].xml": `<Types></Types>`, "word/_rels/document.xml.rels": `<Relationships><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="file:///tmp/photo.png" TargetMode="External"/><Relationship Id="link" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink" Target="https://example.com" TargetMode="External"/></Relationships>`, "word/document.xml": `<document><a:blip r:link="rId2"/></document>`} {
+		e, _ := w.Create(name)
+		e.Write([]byte(content))
+	}
+	w.Close()
+	var photo bytes.Buffer
+	png.Encode(&photo, image.NewRGBA(image.Rect(0, 0, 5, 6)))
+	result, err := embedDOCXPhoto(b.Bytes(), photo.Bytes(), "file:///tmp/photo.png")
+	if err != nil {
+		t.Fatal(err)
+	}
+	z, err := zip.NewReader(bytes.NewReader(result), int64(len(result)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	files := map[string]string{}
+	for _, f := range z.File {
+		r, _ := f.Open()
+		data, _ := io.ReadAll(r)
+		r.Close()
+		files[f.Name] = string(data)
+	}
+	if !strings.Contains(files["word/document.xml"], `r:embed="rId2"`) || strings.Contains(files["word/document.xml"], `r:link="rId2"`) {
+		t.Fatal("drawing still references external image")
+	}
+	if files["word/media/resume-photo.png"] != photo.String() {
+		t.Fatal("portrait was not embedded")
+	}
+	rel := files["word/_rels/document.xml.rels"]
+	if strings.Contains(rel, "file:///tmp") || !strings.Contains(rel, `Target="media/resume-photo.png"`) || !strings.Contains(rel, `Target="https://example.com" TargetMode="External"`) {
+		t.Fatal("incorrect relationship rewrite")
+	}
+	if !strings.Contains(files["[Content_Types].xml"], `ContentType="image/png"`) {
+		t.Fatal("missing PNG content type")
+	}
+}
+func TestInvalidPhotoRejected(t *testing.T) {
+	if _, err := normalizeExportPhoto([]byte("invalid")); err == nil {
+		t.Fatal("invalid photo accepted")
+	}
+}
