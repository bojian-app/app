+package jobs
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestStructuredExportIncludesEveryEntryAndPhoto(t *testing.T) {
+	page := string(renderStructuredResumeHTML("简历", json.RawMessage(`{"personal_info":{"full_name":"李明","phone":"13800000000"},"job_expectation":{"position":"工程师","preference":"个人介绍"},"educations":[{"institution":"测试大学","degree":"本科"}],"work_experiences":[{"company":"公司一","description":"第一份工作"},{"company":"公司二","description":"第二份工作"}],"projects":[{"name":"项目一","achievements":"项目成果"}],"skills":[{"name":"技能一","description":"技能介绍"}],"certifications":[{"name":"证书一","issuer":"颁发单位"}]}`), "file:///tmp/photo.png"))
+	for _, v := range []string{"李明", "工程师", "个人介绍", "测试大学", "公司一", "公司二", "第一份工作", "第二份工作", "项目成果", "技能介绍", "证书一", "file:///tmp/photo.png"} {
+		if !strings.Contains(page, v) {
+			t.Fatalf("missing %s", v)
+		}
+	}
+	if strings.Contains(page, "personal_info") || strings.Contains(page, "<pre>") {
+		t.Fatal("raw JSON exported")
+	}
+}
+func TestRichExportEscapesTextAndRetainsStyles(t *testing.T) {
+	page := string(renderResumeHTML("简历", json.RawMessage(`{"job_expectation":{"preference_rich":{"blocks":[{"kind":"bullet","spans":[{"text":"React ","bold":true},{"text":"<script> & 开发","italic":true}]}]}}}`)))
+	if !strings.Contains(page, "<b>React </b>") || !strings.Contains(page, "&lt;script&gt; &amp; 开发") || !strings.Contains(page, "• ") {
+		t.Fatal("rich text lost")
+	}
+}
