+package jobs
+
+import (
+	"encoding/json"
+	"fmt"
+	"html"
+	"strings"
+)
+
+func renderResumeHTML(title string, content json.RawMessage) []byte {
+	return renderStructuredResumeHTML(title, content, "")
+}
+func renderStructuredResumeHTML(title string, content json.RawMessage, photo string) []byte {
+	var source map[string]any
+	_ = json.Unmarshal(content, &source)
+	obj := func(v any) map[string]any { m, _ := v.(map[string]any); return m }
+	text := func(m map[string]any, k string) string { v, _ := m[k].(string); return strings.TrimSpace(v) }
+	esc := html.EscapeString
+	lines := func(s string) string { return strings.ReplaceAll(esc(s), "\n", "<br>") }
+	var body strings.Builder
+	paragraph := func(value string) {
+		if value != "" {
+			body.WriteString("<p>" + lines(value) + "</p>")
+		}
+	}
+	detail := func(m map[string]any, k string) {
+		rich := obj(m[k+"_rich"])
+		blocks, _ := rich["blocks"].([]any)
+		if len(blocks) == 0 {
+			paragraph(text(m, k))
+			return
+		}
+		number := 0
+		for _, v := range blocks {
+			b := obj(v)
+			spans, _ := b["spans"].([]any)
+			if len(spans) == 0 {
+				continue
+			}
+			body.WriteString("<p>")
+			switch text(b, "kind") {
+			case "bullet":
+				body.WriteString("• ")
+				number = 0
+			case "numbered":
+				number++
+				body.WriteString(fmt.Sprintf("%d. ", number))
+			default:
+				number = 0
+			}
+			for _, raw := range spans {
+				span := obj(raw)
+				rawText, _ := span["text"].(string)
+				value := lines(rawText)
+				if span["bold"] == true {
+					value = "<b>" + value + "</b>"
+				}
+				if span["italic"] == true {
+					value = "<i>" + value + "</i>"
+				}
+				if span["underline"] == true {
+					value = "<u>" + value + "</u>"
+				}
+				if span["strikethrough"] == true {
+					value = "<s>" + value + "</s>"
+				}
+				body.WriteString(value)
+			}
+			body.WriteString("</p>")
+		}
+	}
+	personal := obj(source["personal_info"])
+	job := obj(source["job_expectation"])
+	name := text(personal, "full_name")
+	if name == "" {
+		name = text(source, "name")
+	}
+	if name == "" {
+		name = title
+	}
+	body.WriteString("<table class='header' width='671' cellpadding='0' cellspacing='0'><tr><td width='571'><h1>" + esc(name) + "</h1>")
+	paragraph(text(job, "position"))
+	var contacts []string
+	for _, k := range []string{"phone", "email", "birth_date"} {
+		if v := text(personal, k); v != "" {
+			contacts = append(contacts, v)
+		}
+	}
+	if gender := strings.ToLower(text(personal, "gender")); gender == "male" || gender == "男" {
+		contacts = append(contacts, "男")
+	} else if gender == "female" || gender == "女" {
+		contacts = append(contacts, "女")
+	}
+	paragraph(strings.Join(contacts, "   ·   "))
+	body.WriteString("</td>")
+	if photo != "" {
+		body.WriteString("<td width='100' align='right' style='width:75pt;text-align:right'><img width='100' height='120' src='" + esc(photo) + "'></td>")
+	}
+	body.WriteString("</tr></table><hr size='1' noshade>")
+	var expected []string
+	for _, field := range []struct{ key, label string }{{"position", "期望职位"}, {"city", "期望城市"}, {"industry", "期望行业"}, {"salary", "期望薪资"}} {
+		if v := text(job, field.key); v != "" {
+			expected = append(expected, field.label+": "+v)
+		}
+	}
+	if len(expected) > 0 || text(job, "preference") != "" || job["preference_rich"] != nil {
+		body.WriteString("<h2>求职期望</h2>")
+		paragraph(strings.Join(expected, "   ·   "))
+		detail(job, "preference")
+	}
+	for _, section := range []struct {
+		key, label, heading string
+		meta, details       []string
+	}{
+		{"educations", "教育经历", "institution", []string{"degree", "field_of_study"}, []string{"campus_experience", "thesis_description"}},
+		{"work_experiences", "工作经历", "company", []string{"position", "industry"}, []string{"description"}},
+		{"projects", "项目经历", "name", []string{"role", "url"}, []string{"description", "achievements"}},
+		{"skills", "技能", "name", nil, []string{"description"}},
+		{"certifications", "证书", "name", []string{"issuer"}, nil},
+	} {
+		rows, _ := source[section.key].([]any)
+		visible := false
+		for _, raw := range rows {
+			entry := obj(raw)
+			meaningful := false
+			for _, value := range entry {
+				if s, ok := value.(string); ok && strings.TrimSpace(s) != "" {
+					meaningful = true
+				}
+			}
+			if !meaningful {
+				continue
+			}
+			if !visible {
+				body.WriteString("<h2>" + section.label + "</h2>")
+				visible = true
+			}
+			body.WriteString("<h3>" + esc(text(entry, section.heading)) + "</h3>")
+			var meta []string
+			for _, k := range section.meta {
+				if v := text(entry, k); v != "" {
+					meta = append(meta, v)
+				}
+			}
+			start, end := text(entry, "start_date"), text(entry, "end_date")
+			if section.key == "certifications" {
+				start = text(entry, "date")
+			}
+			if entry["current"] == true || entry["is_current"] == true || end == "present" || end == "current" {
+				end = "至今"
+			}
+			dates := strings.Trim(strings.Join([]string{start, end}, " - "), " -")
+			if len(meta) > 0 || dates != "" {
+				body.WriteString("<table class='metadata' width='671' cellpadding='0' cellspacing='0'><tr><td width='490'>" + esc(strings.Join(meta, " · ")) + "</td><td width='181' align='right' nowrap style='text-align:right'>" + esc(dates) + "</td></tr></table>")
+			}
+			for _, k := range section.details {
+				detail(entry, k)
+			}
+		}
+	}
+	return []byte(`<!doctype html><html><head><meta charset="utf-8"><style>@page{size:A4;margin:16.23mm}body,h1,h2,h3,p,td{font-family:"Noto Sans CJK SC",sans-serif;color:#26292e}body{font-size:10.5pt;line-height:1.38}p{white-space:pre-wrap;margin:0 0 7pt}h1{font-size:25pt;margin:0 0 7pt}h2{font-size:12pt;margin:14pt 0 8pt;page-break-after:avoid}h3{font-size:11pt;margin:8pt 0 7pt;page-break-after:avoid}table{border-collapse:collapse;width:100%}.header td{vertical-align:top}.header p,.metadata{font-size:9.5pt}.metadata{color:#555;margin-bottom:8pt}hr{border:0;border-top:1.5pt solid #26292e;margin:10pt 0 8pt}</style></head><body>` + body.String() + `</body></html>`)
+}
