+package jobs
+
+import (
+	"archive/zip"
+	"bytes"
+	"errors"
+	_ "golang.org/x/image/webp"
+	"html"
+	"image"
+	_ "image/jpeg"
+	"image/png"
+	"io"
+	"regexp"
+	"strings"
+)
+
+func normalizeExportPhoto(data []byte) ([]byte, error) {
+	cfg, _, err := image.DecodeConfig(bytes.NewReader(data))
+	if err != nil || cfg.Width <= 0 || cfg.Height <= 0 || int64(cfg.Width)*int64(cfg.Height) > 16_000_000 {
+		return nil, errors.New("invalid export photo")
+	}
+	img, _, err := image.Decode(bytes.NewReader(data))
+	if err != nil {
+		return nil, errors.New("invalid export photo")
+	}
+	var out bytes.Buffer
+	if err := png.Encode(&out, img); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
+
+// LibreOffice imports HTML images as local file links. Embed the saved portrait
+// in the DOCX package so it survives deletion of the worker's temporary folder.
+func embedDOCXPhoto(data, photo []byte, photoURI string) ([]byte, error) {
+	source, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return nil, err
+	}
+	relationship := regexp.MustCompile(`<Relationship\b[^>]*>`)
+	target := regexp.MustCompile(`Target="[^"]*"`)
+	external := regexp.MustCompile(`\s+TargetMode="External"`)
+	embedded := false
+	var relations []byte
+	var imageIDs []string
+	for _, file := range source.File {
+		if file.Name != "word/_rels/document.xml.rels" {
+			continue
+		}
+		reader, err := file.Open()
+		if err != nil {
+			return nil, err
+		}
+		relations, err = io.ReadAll(io.LimitReader(reader, 30<<20))
+		reader.Close()
+		if err != nil {
+			return nil, err
+		}
+		relations = relationship.ReplaceAllFunc(relations, func(rel []byte) []byte {
+			text := string(rel)
+			if !strings.Contains(text, `/relationships/image"`) || !strings.Contains(text, `TargetMode="External"`) {
+				return rel
+			}
+			attr := target.FindString(text)
+			if len(attr) < 9 || html.UnescapeString(attr[8:len(attr)-1]) != photoURI {
+				return rel
+			}
+			embedded = true
+			idAttr := regexp.MustCompile(`Id="([^"]+)"`).FindStringSubmatch(text)
+			if len(idAttr) == 2 {
+				imageIDs = append(imageIDs, idAttr[1])
+			}
+			rel = target.ReplaceAllLiteral(rel, []byte(`Target="media/resume-photo.png"`))
+			return external.ReplaceAll(rel, nil)
+		})
+	}
+	var output bytes.Buffer
+	writer := zip.NewWriter(&output)
+	for _, file := range source.File {
+		reader, err := file.Open()
+		if err != nil {
+			return nil, err
+		}
+		content, err := io.ReadAll(io.LimitReader(reader, 30<<20))
+		reader.Close()
+		if err != nil {
+			return nil, err
+		}
+		if file.Name == "word/_rels/document.xml.rels" {
+			content = relations
+		}
+		if file.Name == "word/document.xml" {
+			for _, id := range imageIDs {
+				content = bytes.ReplaceAll(content, []byte(`r:link="`+id+`"`), []byte(`r:embed="`+id+`"`))
+			}
+		}
+		if file.Name == "[Content_Types].xml" && !bytes.Contains(content, []byte(`Extension="png"`)) {
+			content = bytes.Replace(content, []byte("</Types>"), []byte(`<Default Extension="png" ContentType="image/png"/></Types>`), 1)
+		}
+		header := file.FileHeader
+		entry, err := writer.CreateHeader(&header)
+		if err != nil {
+			return nil, err
+		}
+		if _, err := entry.Write(content); err != nil {
+			return nil, err
+		}
+	}
+	if !embedded {
+		return nil, errors.New("export portrait relationship missing")
+	}
+	entry, err := writer.Create("word/media/resume-photo.png")
+	if err != nil {
+		return nil, err
+	}
+	if _, err := entry.Write(photo); err != nil {
+		return nil, err
+	}
+	if err := writer.Close(); err != nil {
+		return nil, err
+	}
+	return output.Bytes(), nil
+}
