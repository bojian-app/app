new file mode 100644
--- /dev/null
+++ b/internal/httpapi/realtime_stream.go
@@ -0,0 +1,85 @@
+package httpapi
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+)
+
+// Event streams carry the same durable events and cursor as WebSocket. Native
+// Android HTTP/3 can keep receiving when a carrier resets TCP/TLS connections.
+func (s *Server) realtimeEventStream(w http.ResponseWriter, r *http.Request) {
+	control := http.NewResponseController(w)
+	_ = control.SetWriteDeadline(time.Time{})
+	w.Header().Set("Content-Type", "text/event-stream; charset=utf-8")
+	w.Header().Set("Cache-Control", "no-cache, no-transform")
+	w.Header().Set("X-Accel-Buffering", "no")
+	write := func(data string) error {
+		_ = control.SetWriteDeadline(time.Now().Add(realtimeWriteTimeout))
+		if _, err := fmt.Fprint(w, data); err != nil {
+			return err
+		}
+		if err := control.Flush(); err != nil {
+			return err
+		}
+		return control.SetWriteDeadline(time.Time{})
+	}
+	send := func(event map[string]any) error {
+		payload, err := json.Marshal(event)
+		if err != nil {
+			return err
+		}
+		return write("data: " + string(payload) + "\n\n")
+	}
+	cursor, _ := strconv.ParseInt(r.URL.Query().Get("cursor"), 10, 64)
+	if cursor < 0 {
+		cursor = 0
+	}
+	// Flush a heartbeat immediately, even if the outbox has no pending events.
+	if err := write(": connected\n\n"); err != nil {
+		return
+	}
+	drain := func() bool {
+		for {
+			last, ok := s.writeRealtimeBatch(r, cursor, send)
+			if !ok {
+				return false
+			}
+			if last <= cursor {
+				return true
+			}
+			cursor = last
+		}
+	}
+	channel := realtimeChannelPrefix + strconv.FormatInt(UserID(r.Context()), 10)
+	sub := s.redis.Subscribe(r.Context(), channel)
+	defer sub.Close()
+	notify := sub.Channel()
+	tick := time.NewTicker(realtimeSessionCheckInterval)
+	defer tick.Stop()
+	heartbeat := time.NewTicker(20 * time.Second)
+	defer heartbeat.Stop()
+	if !drain() {
+		return
+	}
+	for {
+		select {
+		case <-r.Context().Done():
+			return
+		case <-tick.C:
+			if !drain() {
+				return
+			}
+		case <-heartbeat.C:
+			if write(": keepalive\n\n") != nil {
+				return
+			}
+		case _, ok := <-notify:
+			if !ok || !drain() {
+				return
+			}
+		}
+	}
+}
