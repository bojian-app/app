+package jobs
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWordResumeUsesRenderedPDFWithLite(t *testing.T) {
+	for _, extension := range []string{".doc", ".DOCX"} {
+		t.Run(extension, func(t *testing.T) {
+			dir := t.TempDir()
+			input := filepath.Join(dir, "简历 模板"+extension)
+			original := "original-word-content"
+			if err := os.WriteFile(input, []byte(original), 0600); err != nil {
+				t.Fatal(err)
+			}
+			converter := filepath.Join(dir, "convert")
+			script := `#!/bin/sh
+case "$1" in -env:UserInstallation=file://*) ;; *) exit 1 ;; esac
+[ "$2" = "--headless" ] && [ "$3" = "--convert-to" ] && [ "$4" = "pdf" ] && [ "$5" = "--outdir" ] || exit 1
+name=$(basename "$7")
+printf '%%PDF-1.4\nrendered-floating-text-box\n' > "$6/${name%.*}.pdf"
+`
+			if err := os.WriteFile(converter, []byte(script), 0700); err != nil {
+				t.Fatal(err)
+			}
+			worker := New(slog.Default(), nil, nil, Options{LibreOfficePath: converter, AIBaseURL: "https://ai.example.test/v1", AIAPIKey: "test-key", AITimeout: time.Second})
+			calls := 0
+			var convertedPath string
+			worker.httpClient = &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				body := `{"status":"succeeded","content":"姓名\n文本框中的工作经历"}`
+				if r.Method == http.MethodPost {
+					if err := r.ParseMultipartForm(1 << 20); err != nil {
+						t.Fatal(err)
+					}
+					defer r.MultipartForm.RemoveAll()
+					if r.FormValue("tool_type") != "lite" || r.FormValue("file_type") != "PDF" {
+						t.Fatal("Word was not rendered for Lite")
+					}
+					f, header, err := r.FormFile("file")
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer f.Close()
+					data, _ := io.ReadAll(f)
+					if header.Filename != "简历 模板.pdf" || !strings.HasPrefix(string(data), "%PDF-1.4") {
+						t.Fatal("wrong uploaded document")
+					}
+					// The task-local PDF exists during upload and is removed afterwards.
+					entries, _ := filepath.Glob(filepath.Join(os.TempDir(), "bojian-import-word-*", "简历 模板.pdf"))
+					if len(entries) != 1 {
+						t.Fatalf("converted files=%d", len(entries))
+					}
+					convertedPath = entries[0]
+					body = `{"task_id":"word-task"}`
+				}
+				return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(body))}, nil
+			})}
+			text, task, err := worker.callImportDocumentParser(context.Background(), input)
+			if err != nil || text != "姓名\n文本框中的工作经历" || task != "word-task" || calls != 2 {
+				t.Fatalf("conversion/recognition failed: %v", err)
+			}
+			if _, err := os.Stat(convertedPath); !os.IsNotExist(err) {
+				t.Fatal("temporary PDF was not cleaned")
+			}
+			data, _ := os.ReadFile(input)
+			if string(data) != original {
+				t.Fatal("original Word changed")
+			}
+		})
+	}
+}
+
+func TestWordConversionFailuresDoNotCallAI(t *testing.T) {
+	for name, script := range map[string]string{"failed": "#!/bin/sh\nexit 1\n", "no_output": "#!/bin/sh\nexit 0\n"} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			converter := filepath.Join(dir, "convert")
+			if err := os.WriteFile(converter, []byte(script), 0700); err != nil {
+				t.Fatal(err)
+			}
+			worker := New(slog.Default(), nil, nil, Options{LibreOfficePath: converter})
+			worker.httpClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+				t.Fatal("AI called after conversion failed")
+				return nil, nil
+			})}
+			if _, _, err := worker.callImportDocumentParser(context.Background(), filepath.Join(dir, "resume.docx")); err == nil {
+				t.Fatal("missing conversion error")
+			}
+		})
+	}
+}
