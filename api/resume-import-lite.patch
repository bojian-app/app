+package jobs
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Word templates can keep all visible text in floating shapes that Lite omits.
+// Render their visible pages to PDF before Lite recognition; AI still groups
+// the extracted content into resume fields in callResumeParser.
+func (w *Worker) callImportDocumentParser(ctx context.Context, filename string) (string, string, error) {
+	extension := strings.ToLower(filepath.Ext(filename))
+	if extension != ".doc" && extension != ".docx" {
+		return w.callDocumentParser(ctx, filename)
+	}
+	if err := ctx.Err(); err != nil {
+		return "", "", err
+	}
+	dir, err := os.MkdirTemp("", "bojian-import-word-*")
+	if err != nil {
+		return "", "", errors.New("无法准备 Word 简历转换目录")
+	}
+	defer os.RemoveAll(dir)
+	renderCtx, cancel := context.WithTimeout(ctx, 90*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(renderCtx, w.libreOfficePath,
+		libreOfficeProfileArg(dir), "--headless", "--convert-to", "pdf", "--outdir", dir, filename)
+	if err := cmd.Run(); err != nil {
+		if renderCtx.Err() != nil {
+			return "", "", renderCtx.Err()
+		}
+		return "", "", errors.New("Word 简历转换失败，请检查文件是否完整或受密码保护")
+	}
+	pdf := filepath.Join(dir, strings.TrimSuffix(filepath.Base(filename), filepath.Ext(filename))+".pdf")
+	info, err := os.Stat(pdf)
+	if err != nil || !info.Mode().IsRegular() || info.Size() == 0 {
+		return "", "", errors.New("Word 简历转换未生成有效 PDF")
+	}
+	if info.Size() > 20<<20 {
+		return "", "", errors.New("Word 简历转换后的 PDF 超过 20 MB")
+	}
+	return w.callDocumentParser(ctx, pdf)
+}
