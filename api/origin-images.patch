+// PresignOriginDownload provides short-lived image links without relying on CDN.
+// Store implementations without an origin retain their existing download links.
+func (k *Kodo) PresignOriginDownload(ctx context.Context, objectKey string) (string, time.Time, error) {
+	urls, err := downloader.GetURLStrings(ctx, k.originURLs, objectKey, &downloader.GenerateOptions{BucketName: k.bucket})
+	if err != nil {
+		return "", time.Time{}, errors.New("qiniu origin lookup failed")
+	}
+	if len(urls) == 0 {
+		return "", time.Time{}, errors.New("qiniu returned no origin download URL")
+	}
+	return urls[0], time.Now().Add(time.Minute), nil
+}
