+func TestImageLinksUseSignedOriginWithoutChangingOtherDownloads(t *testing.T) {
+	k := testKodo(t)
+	k.originURLs = downloader.SignURLsProvider(
+		downloader.NewStaticDomainBasedURLsProvider([]string{"https://origin.example.com"}),
+		downloader.NewCredentialsSigner(k.credentials), &downloader.SignOptions{TTL: time.Minute},
+	)
+	link, expires, err := k.PresignOriginDownload(context.Background(), "users/1/RESUME_PHOTO/photo.jpg")
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := url.Parse(link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if parsed.Scheme != "https" || parsed.Host != "origin.example.com" || parsed.Query().Get("token") == "" {
+		t.Fatal("image URL must use authenticated HTTPS origin")
+	}
+	deadline, err := strconv.ParseInt(parsed.Query().Get("e"), 10, 64)
+	if err != nil || deadline > time.Now().Add(61*time.Second).Unix() || deadline < time.Now().Unix() {
+		t.Fatal("origin signature must expire within one minute")
+	}
+	if expires.After(time.Now().Add(61 * time.Second)) {
+		t.Fatal("unexpected expiry")
+	}
+	other, _, err := k.PresignDownload(context.Background(), "document.pdf")
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, _ = url.Parse(other)
+	if parsed.Host != "cdn.example.com" {
+		t.Fatal("document download changed")
+	}
+}
