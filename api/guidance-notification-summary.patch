--- a/internal/httpapi/guidance_notification_summary.go
+++ b/internal/httpapi/guidance_notification_summary.go
@@ -0,0 +1,117 @@
+package httpapi
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+)
+
+func guidanceFeedbackKind(comments, rewrites int) string {
+	if comments > 0 && rewrites > 0 {
+		return "MIXED"
+	}
+	if rewrites > 0 {
+		return "REWRITE"
+	}
+	if comments > 0 {
+		return "COMMENT"
+	}
+	return "GUIDANCE"
+}
+
+func guidanceFeedbackSummary(title, kind string) map[string]any {
+	return map[string]any{"title": "收到简历优化建议", "body": title,
+		"resume_title": title, "feedback_type": kind}
+}
+
+func guidanceFeedbackNotificationPayload(item map[string]any) map[string]any {
+	payload := map[string]any{}
+	switch value := item["payload"].(type) {
+	case json.RawMessage:
+		_ = json.Unmarshal(value, &payload)
+	case map[string]any:
+		payload = value
+	}
+	if payload == nil {
+		payload = map[string]any{}
+	}
+	return payload
+}
+
+// Enrich old annotation notifications without changing their stored payloads.
+// Match the annotation's actor, scope and share to this recipient's notification.
+func (s *Server) decorateGuidanceFeedbackNotifications(r *http.Request, items []map[string]any) error {
+	ids := []int64{}
+	for _, item := range items {
+		if item["type"] == "RESUME_GUIDANCE_FEEDBACK" && guidanceFeedbackNotificationPayload(item)["annotation_id"] != nil {
+			ids = append(ids, item["id"].(int64))
+		}
+	}
+	type annotationSummary struct{ rewrite, reply bool }
+	annotations := map[int64]annotationSummary{}
+	if len(ids) > 0 {
+		rows, err := s.db.Query(r.Context(), `SELECT n.id,a.replacement<>'',a.parent_id IS NOT NULL FROM notifications n JOIN resume_guidance_annotations a ON a.id::text=n.payload_safe_jsonb->>'annotation_id' AND a.share_id=n.subject_id AND a.reviewer_id=n.actor_id AND ((a.scope='ARTICLE' AND n.subject_type='ARTICLE') OR (a.scope='NOTIFICATION' AND n.subject_type='GUIDANCE_NOTIFICATION')) WHERE n.user_id=$1 AND n.id=ANY($2) AND n.type='RESUME_GUIDANCE_FEEDBACK'`, UserID(r.Context()), ids)
+		if err != nil {
+			return err
+		}
+		for rows.Next() {
+			var id int64
+			var summary annotationSummary
+			if err := rows.Scan(&id, &summary.rewrite, &summary.reply); err != nil {
+				rows.Close()
+				return err
+			}
+			annotations[id] = summary
+		}
+		err = rows.Err()
+		rows.Close()
+		if err != nil {
+			return err
+		}
+	}
+	for _, item := range items {
+		if item["type"] != "RESUME_GUIDANCE_FEEDBACK" {
+			continue
+		}
+		payload := guidanceFeedbackNotificationPayload(item)
+		kind, _ := payload["feedback_type"].(string)
+		if summary, ok := annotations[item["id"].(int64)]; ok {
+			kind = "COMMENT"
+			if summary.rewrite {
+				kind = "REWRITE"
+			} else if summary.reply {
+				kind = "REPLY"
+			}
+		}
+		name := "未设置用户昵称"
+		if actor, ok := item["actor"].(map[string]any); ok {
+			if display, ok := actor["display_name"].(string); ok && strings.TrimSpace(display) != "" {
+				name = strings.TrimSpace(display)
+			}
+		}
+		action := "为你的简历提供了优化建议"
+		switch kind {
+		case "COMMENT":
+			action = "评论了你的简历"
+		case "REWRITE":
+			action = "为你的简历提出了改写建议"
+		case "REPLY":
+			action = "回复了你在简历中的评论"
+		case "MIXED":
+			action = "为你的简历提供了评论和改写建议"
+		default:
+			kind = "GUIDANCE"
+		}
+		title, _ := payload["resume_title"].(string)
+		if title == "" {
+			title, _ = payload["body"].(string)
+		}
+		payload["title"] = name + action
+		payload["feedback_type"], payload["resume_title"] = kind, title
+		if title != "" {
+			payload["body"] = "《" + title + "》"
+		}
+		item["payload"] = payload
+	}
+	return nil
+}
