+func TestGuidanceNotificationSummariesIntegration(t *testing.T) {
+	dsn := os.Getenv("TEMPLATE_TEST_DATABASE_URL")
+	if dsn == "" {
+		t.Skip("isolated DB required")
+	}
+	u, err := url.Parse(dsn)
+	if err != nil || (u.Hostname() != "127.0.0.1" && u.Hostname() != "localhost") {
+		t.Fatal("local database required")
+	}
+	ctx := context.Background()
+	admin, err := pgxpool.New(ctx, dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Close()
+	schema := fmt.Sprintf("guidance_notifications_%d", time.Now().UnixNano())
+	if _, err := admin.Exec(ctx, "CREATE SCHEMA "+schema); err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Exec(ctx, "DROP SCHEMA "+schema+" CASCADE")
+	cfg, _ := pgxpool.ParseConfig(dsn)
+	cfg.ConnConfig.RuntimeParams["search_path"] = schema
+	db, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(ctx, `CREATE TABLE users(id bigint PRIMARY KEY,nickname text,status text,deleted_at timestamptz,avatar_file_id bigint);
+ CREATE TABLE notifications(id bigint PRIMARY KEY,user_id bigint,type text,actor_id bigint,subject_type text,subject_id bigint,payload_safe_jsonb jsonb,delivered_at timestamptz,read_at timestamptz,created_at timestamptz DEFAULT now());
+ CREATE TABLE resume_guidance_annotations(id bigint PRIMARY KEY,scope text,share_id bigint,reviewer_id bigint,replacement text,suggestion text,parent_id bigint);
+ INSERT INTO users VALUES(1,'作者','ACTIVE',NULL,NULL),(2,'小林','ACTIVE',NULL,NULL),(3,'  ','ACTIVE',NULL,NULL);
+ INSERT INTO resume_guidance_annotations VALUES(7,'ARTICLE',20,2,'','补充指标',NULL),(8,'NOTIFICATION',21,2,'负责前端研发','',NULL),(9,'ARTICLE',20,3,'','谢谢建议',7);
+ INSERT INTO notifications(id,user_id,type,actor_id,subject_type,subject_id,payload_safe_jsonb) VALUES
+ (1,1,'RESUME_GUIDANCE_FEEDBACK',2,'ARTICLE',20,'{"title":"收到简历指点","body":"前端简历","annotation_id":7}'),
+ (2,1,'RESUME_GUIDANCE_FEEDBACK',2,'GUIDANCE_NOTIFICATION',21,'{"title":"收到简历指点","body":"私密简历","annotation_id":8,"guidance":{"snapshot":{"private":"SECRET"}}}'),
+ (3,1,'RESUME_GUIDANCE_FEEDBACK',3,'ARTICLE',20,'{"title":"收到简历指点","body":"前端简历","annotation_id":9}'),
+ (4,1,'RESUME_GUIDANCE_FEEDBACK',2,'GUIDANCE_NOTIFICATION',99,'{"title":"收到简历指点","body":"其他简历","annotation_id":8}'),
+ (5,1,'RESUME_GUIDANCE_FEEDBACK',2,'ARTICLE',20,'{"title":"收到简历优化建议","body":"前端简历","feedback_type":"MIXED","suggestion_count":2}'),
+ (6,1,'RESUME_GUIDANCE_FEEDBACK',2,'ARTICLE',20,'{"title":"收到简历优化建议","body":"历史简历","suggestion_count":1}'),
+ (100,99,'RESUME_GUIDANCE_FEEDBACK',2,'ARTICLE',20,'{"title":"不是本用户的通知","annotation_id":7}');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &Server{db: db, logger: slog.Default()}
+	list := func(query string) (map[string]any, string) {
+		t.Helper()
+		req := httptest.NewRequest("GET", "/api/v1/notifications"+query, nil)
+		req = req.WithContext(context.WithValue(req.Context(), userIDKey, int64(1)))
+		rec := httptest.NewRecorder()
+		server.listNotifications(rec, req)
+		if rec.Code != 200 {
+			t.Fatalf("list failed: %d %s", rec.Code, rec.Body.String())
+		}
+		if strings.Contains(rec.Body.String(), "SECRET") || strings.Contains(rec.Body.String(), `"guidance":`) {
+			t.Fatal("private snapshot exposed in notification list")
+		}
+		var envelope map[string]any
+		if err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil {
+			t.Fatal(err)
+		}
+		cursor, _ := envelope["meta"].(map[string]any)["next_cursor"].(string)
+		return envelope["data"].(map[string]any), cursor
+	}
+	data, _ := list("")
+	if data["total_count"] != float64(6) || data["unread_count"] != float64(6) {
+		t.Fatal("recipient counts changed", data)
+	}
+	byID := map[int64]map[string]any{}
+	for _, raw := range data["items"].([]any) {
+		item := raw.(map[string]any)
+		byID[int64(item["id"].(float64))] = item["payload"].(map[string]any)
+	}
+	for _, expected := range []struct {
+		id          int64
+		kind, title string
+	}{
+		{1, "COMMENT", "小林评论了你的简历"}, {2, "REWRITE", "小林为你的简历提出了改写建议"},
+		{3, "REPLY", "未设置用户昵称回复了你在简历中的评论"}, {4, "GUIDANCE", "小林为你的简历提供了优化建议"},
+		{5, "MIXED", "小林为你的简历提供了评论和改写建议"}, {6, "GUIDANCE", "小林为你的简历提供了优化建议"},
+	} {
+		payload := byID[expected.id]
+		if payload["feedback_type"] != expected.kind || payload["title"] != expected.title {
+			t.Fatalf("incorrect summary for %d: %#v", expected.id, payload)
+		}
+	}
+	if byID[2]["resume_title"] != "私密简历" || !strings.Contains(byID[2]["body"].(string), "私密简历") {
+		t.Fatal("missing resume title")
+	}
+	if strings.Contains(byID[4]["body"].(string), "前端研发") {
+		t.Fatal("cross-share annotation preview exposed")
+	}
+	first, cursor := list("?limit=3")
+	if len(first["items"].([]any)) != 3 || cursor == "" {
+		t.Fatal("pagination changed")
+	}
+	second, _ := list("?limit=3&cursor=" + url.QueryEscape(cursor))
+	if len(second["items"].([]any)) != 3 {
+		t.Fatal("missing notification page")
+	}
+	if _, err := db.Exec(ctx, `UPDATE users SET nickname='新昵称' WHERE id=2`); err != nil {
+		t.Fatal(err)
+	}
+	updated, _ := list("")
+	for _, raw := range updated["items"].([]any) {
+		item := raw.(map[string]any)
+		if item["actor_id"] == float64(2) && !strings.HasPrefix(item["payload"].(map[string]any)["title"].(string), "新昵称") {
+			t.Fatal("actor name did not update")
+		}
+	}
+}
