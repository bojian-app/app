+
+func TestOriginConnectionFailureDoesNotLeakDownloadSignature(t *testing.T) {
+	client := testKodo(t)
+	client.originURLs = downloader.NewStaticDomainBasedURLsProvider([]string{"https://origin.example.com"})
+	client.downloadHTTP = &http.Client{Transport: originFailureTransport{}}
+	_, err := client.Get(context.Background(), "private/resume.pdf?token=secret")
+	if err == nil || err.Error() != "qiniu origin connection failed" {
+		t.Fatalf("unsafe error: %v", err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = client.Get(ctx, "resume.pdf")
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected cancellation, got %v", err)
+	}
+}
