@@ -0,0 +1,34 @@
+-- New comments notify the article author and the direct reply recipient once each.
+-- Notifications and their durable realtime events commit with the comment.
+CREATE FUNCTION article_comment_notification_inserted() RETURNS trigger
+LANGUAGE plpgsql AS $$
+BEGIN
+    IF NEW.status <> 'VISIBLE' OR NEW.deleted_at IS NOT NULL THEN RETURN NEW; END IF;
+    INSERT INTO notifications(user_id,type,actor_id,subject_type,subject_id,payload_safe_jsonb,created_at)
+    SELECT recipient.id,
+        CASE WHEN recipient.id=target.author_id THEN 'COMMENT_REPLY' ELSE 'ARTICLE_COMMENT' END,
+        NEW.author_id,'ARTICLE',p.id,
+        jsonb_build_object('title',CASE WHEN recipient.id=target.author_id THEN '收到新的回复' ELSE '收到新的评论' END,
+            'body',COALESCE(NULLIF(btrim(actor.nickname),''),'用户') ||
+                CASE WHEN recipient.id=target.author_id THEN '回复了你的评论：' ELSE '评论了你的文章《' || p.title || '》：' END || left(NEW.content,120),
+            'comment_id',NEW.id), NEW.created_at
+    FROM posts p
+    JOIN users owner ON owner.id=p.author_id AND owner.status='ACTIVE' AND owner.deleted_at IS NULL
+    JOIN users actor ON actor.id=NEW.author_id AND actor.status='ACTIVE' AND actor.deleted_at IS NULL
+    LEFT JOIN post_comments target ON target.id=NEW.reply_to_id AND target.post_id=p.id
+        AND target.status='VISIBLE' AND target.deleted_at IS NULL
+    JOIN users recipient ON (recipient.id=p.author_id OR recipient.id=target.author_id)
+        AND recipient.status='ACTIVE' AND recipient.deleted_at IS NULL
+    WHERE p.id=NEW.post_id AND p.status='PUBLISHED' AND p.deleted_at IS NULL
+        AND recipient.id<>NEW.author_id
+        AND (recipient.id=p.author_id OR p.visibility='PUBLIC' OR
+            (p.visibility='FRIENDS' AND EXISTS(SELECT 1 FROM friendships f
+                WHERE f.user_low_id=LEAST(recipient.id,p.author_id) AND f.user_high_id=GREATEST(recipient.id,p.author_id))))
+        AND NOT EXISTS(SELECT 1 FROM user_blocks b WHERE
+            (b.blocker_id=recipient.id AND b.blocked_id IN (NEW.author_id,p.author_id)) OR
+            (b.blocked_id=recipient.id AND b.blocker_id IN (NEW.author_id,p.author_id)));
+    RETURN NEW;
+END;
+$$;
+CREATE TRIGGER notify_article_comment_insert AFTER INSERT ON post_comments
+FOR EACH ROW EXECUTE FUNCTION article_comment_notification_inserted();
