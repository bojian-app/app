@@ -0,0 +1,29 @@
+package httpapi
+
+import (
+	"net/http"
+	"strings"
+)
+
+// Use precisely the same visibility rules as the comment list, including replies.
+// Batch counts so a feed page does not issue one database query per article.
+func (s *Server) articleCommentCounts(r *http.Request, ids []int64) (map[int64]int64, error) {
+	counts := make(map[int64]int64, len(ids))
+	if len(ids) == 0 {
+		return counts, nil
+	}
+	predicate := strings.ReplaceAll(visibleArticleComments, "$1", "c.post_id")
+	rows, err := s.db.Query(r.Context(), `SELECT c.post_id,count(*)`+commentJoins+` WHERE c.post_id=ANY($1::bigint[]) AND `+predicate+` GROUP BY c.post_id`, ids, UserID(r.Context()))
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var id, count int64
+		if err := rows.Scan(&id, &count); err != nil {
+			return nil, err
+		}
+		counts[id] = count
+	}
+	return counts, rows.Err()
+}
