+// SignedURL is returned only by an audited, permission-protected evidence read.
+func (a *Access) SignedURL(key string) (string, error) {
+	parts := strings.Split(key, "/")
+	for i, p := range parts {
+		if p == "" || p == "." || p == ".." {
+			return "", errors.New("invalid evidence key")
+		}
+		parts[i] = url.PathEscape(p)
+	}
+	raw := a.domain + "/" + strings.Join(parts, "/") + fmt.Sprintf("?e=%d", time.Now().Add(10*time.Minute).Unix())
+	h := hmac.New(sha1.New, []byte(a.secretKey))
+	h.Write([]byte(raw))
+	return raw + "&token=" + a.accessKey + ":" + base64.URLEncoding.EncodeToString(h.Sum(nil)), nil
+}
