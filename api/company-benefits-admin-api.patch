+package httpapi
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+)
+
+func (s *Server) benefitError(w http.ResponseWriter, r *http.Request, err error) {
+	var e *pgconn.PgError
+	if errors.As(err, &e) && e.Code == "23505" {
+		failure(w, r, 409, "DUPLICATE_COMPANY", "同企业、城市及岗位已有记录，请编辑现有记录", nil)
+		return
+	}
+	s.logger.Error("company benefits", "error", err)
+	failure(w, r, 500, "INTERNAL_ERROR", "企业福利操作失败，请重试", nil)
+}
+func (s *Server) adminListBenefits(w http.ResponseWriter, r *http.Request) {
+	q := strings.TrimSpace(r.URL.Query().Get("query"))
+	status := strings.TrimSpace(r.URL.Query().Get("status"))
+	cursor, _ := strconv.ParseInt(r.URL.Query().Get("cursor"), 10, 64)
+	rows, err := s.db.Query(r.Context(), `SELECT `+benefitPublicColumns+`,status FROM company_benefits WHERE ($1='' OR strpos(lower(company_name),lower($1))>0) AND ($2='' OR status=$2) AND ($3::bigint=0 OR id<$3) ORDER BY id DESC LIMIT $4`, q, status, cursor, queryLimit(r))
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	defer rows.Close()
+	items := []map[string]any{}
+	// Scan all columns explicitly, including unpublished status.
+	for rows.Next() {
+		var id, rev int64
+		var c benefitContent
+		var raw []byte
+		var verified time.Time
+		var st string
+		if err = rows.Scan(&id, &c.CompanyName, &c.Province, &c.City, &c.Industry, &c.JobScope, &c.ValidAsOf, &raw, &c.OfficialNote, &rev, &verified, &st); err != nil {
+			s.benefitError(w, r, err)
+			return
+		}
+		if err = json.Unmarshal(raw, &c.Benefits); err != nil {
+			s.benefitError(w, r, err)
+			return
+		}
+		items = append(items, map[string]any{"id": id, "content": c, "revision": rev, "verified_at": verified, "status": st})
+	}
+	if err = rows.Err(); err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	success(w, r, 200, map[string]any{"items": items})
+}
+func (s *Server) adminWriteBenefit(w http.ResponseWriter, r *http.Request) {
+	var in struct {
+		Content  benefitContent `json:"content"`
+		Status   string         `json:"status"`
+		Revision int64          `json:"revision"`
+	}
+	if decodeBenefitJSON(w, r, &in) != nil {
+		failure(w, r, 422, "INVALID_ARGUMENT", "请求格式无效", nil)
+		return
+	}
+	if err := in.Content.validate(); err != nil {
+		failure(w, r, 422, "INVALID_ARGUMENT", err.Error(), nil)
+		return
+	}
+	if in.Status != "PUBLISHED" && in.Status != "ARCHIVED" {
+		failure(w, r, 422, "INVALID_ARGUMENT", "收录状态无效", nil)
+		return
+	}
+	raw, _ := json.Marshal(in.Content.Benefits)
+	var id int64
+	var err error
+	if r.Method == "POST" {
+		err = s.db.QueryRow(r.Context(), `INSERT INTO company_benefits(company_name,province,city,industry,job_scope,valid_as_of,benefits_jsonb,official_note,status) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9) RETURNING id`, in.Content.CompanyName, in.Content.Province, in.Content.City, in.Content.Industry, in.Content.JobScope, in.Content.ValidAsOf, raw, in.Content.OfficialNote, in.Status).Scan(&id)
+	} else {
+		var ok bool
+		id, ok = pathID(w, r, "企业")
+		if !ok {
+			return
+		}
+		err = s.db.QueryRow(r.Context(), `UPDATE company_benefits SET company_name=$2,province=$3,city=$4,industry=$5,job_scope=$6,valid_as_of=$7,benefits_jsonb=$8,official_note=$9,status=$10,revision=revision+1,verified_at=now(),updated_at=now() WHERE id=$1 AND revision=$11 RETURNING id`, id, in.Content.CompanyName, in.Content.Province, in.Content.City, in.Content.Industry, in.Content.JobScope, in.Content.ValidAsOf, raw, in.Content.OfficialNote, in.Status, in.Revision).Scan(&id)
+	}
+	if err == pgx.ErrNoRows {
+		failure(w, r, 409, "STATE_CONFLICT", "记录已变化，请刷新", nil)
+		return
+	}
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	success(w, r, 200, map[string]any{"id": id})
+}
+func (s *Server) adminListBenefitSubmissions(w http.ResponseWriter, r *http.Request) {
+	status := strings.TrimSpace(r.URL.Query().Get("status"))
+	q := strings.TrimSpace(r.URL.Query().Get("query"))
+	cursor, _ := strconv.ParseInt(r.URL.Query().Get("cursor"), 10, 64)
+	rows, err := s.db.Query(r.Context(), `SELECT `+benefitSubmissionColumns+` FROM company_benefit_submissions WHERE ($1='' OR status=$1) AND ($2='' OR strpos(lower(content_jsonb->>'company_name'),lower($2))>0) AND ($3::bigint=0 OR id<$3) ORDER BY id DESC LIMIT $4`, status, q, cursor, queryLimit(r))
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	defer rows.Close()
+	items := []map[string]any{}
+	for rows.Next() {
+		item, e := scanBenefitSubmission(rows)
+		if e != nil {
+			s.benefitError(w, r, e)
+			return
+		}
+		delete(item, "employment_file_ids")
+		delete(item, "evidence_file_ids")
+		items = append(items, item)
+	}
+	if err = rows.Err(); err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	w.Header().Set("Cache-Control", "no-store")
+	success(w, r, 200, map[string]any{"items": items})
+}
+func (s *Server) adminBenefitSubmission(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r, "提交")
+	if !ok {
+		return
+	}
+	w.Header().Set("Cache-Control", "no-store")
+	item, err := scanBenefitSubmission(s.db.QueryRow(r.Context(), `SELECT `+benefitSubmissionColumns+` FROM company_benefit_submissions WHERE id=$1`, id))
+	if err == pgx.ErrNoRows {
+		failure(w, r, 404, "NOT_FOUND", "提交记录不存在", nil)
+		return
+	}
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	var owner int64
+	if err = s.db.QueryRow(r.Context(), `SELECT user_id FROM company_benefit_submissions WHERE id=$1`, id).Scan(&owner); err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	item["user_id"] = owner
+	rows, err := s.db.Query(r.Context(), `SELECT f.id,f.purpose,f.original_name,f.content_type,f.size_bytes,f.object_key FROM files f JOIN company_benefit_submissions s ON s.id=$1 AND f.owner_id=s.user_id WHERE f.status='READY' AND f.deleted_at IS NULL AND ((f.id=ANY(s.employment_file_ids) AND f.purpose='EMPLOYMENT_PROOF') OR (f.id=ANY(s.evidence_file_ids) AND f.purpose='BENEFIT_EVIDENCE'))`, id)
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	defer rows.Close()
+	files := []map[string]any{}
+	for rows.Next() {
+		var fid, size int64
+		var purpose, name, mime, key string
+		if err = rows.Scan(&fid, &purpose, &name, &mime, &size, &key); err != nil {
+			s.benefitError(w, r, err)
+			return
+		}
+		signed := ""
+		if s.evidence != nil {
+			signed, err = s.evidence.SignedURL(key)
+			if err != nil {
+				s.benefitError(w, r, err)
+				return
+			}
+		}
+		files = append(files, map[string]any{"id": fid, "purpose": purpose, "name": name, "content_type": mime, "size_bytes": size, "url": signed})
+	}
+	if err = rows.Err(); err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	item["files"] = files
+	historyRows, err := s.db.Query(r.Context(), `SELECT decision,reason,created_at FROM company_benefit_reviews WHERE submission_id=$1 ORDER BY id DESC LIMIT 100`, id)
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	defer historyRows.Close()
+	history := []map[string]any{}
+	for historyRows.Next() {
+		var decision, reason string
+		var at time.Time
+		if err = historyRows.Scan(&decision, &reason, &at); err != nil {
+			s.benefitError(w, r, err)
+			return
+		}
+		history = append(history, map[string]any{"decision": decision, "reason": reason, "created_at": at})
+	}
+	if err = historyRows.Err(); err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	item["history"] = history
+	success(w, r, 200, item)
+}
+func (s *Server) adminDecideBenefit(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r, "提交")
+	if !ok {
+		return
+	}
+	var in struct {
+		Decision  string         `json:"decision"`
+		Reason    string         `json:"reason"`
+		Revision  int64          `json:"revision"`
+		Content   benefitContent `json:"content"`
+		CompanyID *int64         `json:"company_id"`
+	}
+	if decodeBenefitJSON(w, r, &in) != nil {
+		failure(w, r, 422, "INVALID_ARGUMENT", "审核内容格式无效", nil)
+		return
+	}
+	in.Reason = strings.TrimSpace(in.Reason)
+	if (in.Decision != "APPROVED" && in.Decision != "REJECTED" && in.Decision != "NEEDS_MORE") || len(in.Reason) < 2 || len(in.Reason) > 3000 {
+		failure(w, r, 422, "INVALID_ARGUMENT", "请填写审核结果和说明", nil)
+		return
+	}
+	if in.Decision == "APPROVED" {
+		if s.evidence == nil {
+			failure(w, r, 503, "EVIDENCE_UNAVAILABLE", "材料访问未配置，无法完成核实", nil)
+			return
+		}
+		if err := in.Content.validate(); err != nil {
+			failure(w, r, 422, "INVALID_ARGUMENT", err.Error(), nil)
+			return
+		}
+	}
+	tx, err := s.db.Begin(r.Context())
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	defer tx.Rollback(r.Context())
+	var owner, revision int64
+	var status string
+	var company *int64
+	var proof, evidence []int64
+	err = tx.QueryRow(r.Context(), `SELECT user_id,revision,status,company_id,employment_file_ids,evidence_file_ids FROM company_benefit_submissions WHERE id=$1 FOR UPDATE`, id).Scan(&owner, &revision, &status, &company, &proof, &evidence)
+	if err == pgx.ErrNoRows {
+		failure(w, r, 404, "NOT_FOUND", "提交记录不存在", nil)
+		return
+	}
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	if status != "PENDING" || revision != in.Revision {
+		failure(w, r, 409, "STATE_CONFLICT", "提交已被处理或用户已补充材料，请刷新", nil)
+		return
+	}
+	if in.Decision == "APPROVED" {
+		for _, g := range []struct {
+			ids     []int64
+			purpose string
+		}{{proof, "EMPLOYMENT_PROOF"}, {evidence, "BENEFIT_EVIDENCE"}} {
+			var count int
+			err = tx.QueryRow(r.Context(), `SELECT count(*) FROM files WHERE id=ANY($1) AND owner_id=$2 AND purpose=$3 AND status='READY' AND deleted_at IS NULL`, g.ids, owner, g.purpose).Scan(&count)
+			if err != nil {
+				s.benefitError(w, r, err)
+				return
+			}
+			if count != len(g.ids) || count == 0 {
+				failure(w, r, 409, "PROOF_UNAVAILABLE", "证明材料不可用，请要求用户补充", nil)
+				return
+			}
+		}
+		raw, _ := json.Marshal(in.Content.Benefits)
+		if in.CompanyID != nil {
+			company = in.CompanyID
+		}
+		if company == nil {
+			var created int64
+			err = tx.QueryRow(r.Context(), `INSERT INTO company_benefits(company_name,province,city,industry,job_scope,valid_as_of,benefits_jsonb,official_note) VALUES($1,$2,$3,$4,$5,$6,$7,$8) RETURNING id`, in.Content.CompanyName, in.Content.Province, in.Content.City, in.Content.Industry, in.Content.JobScope, in.Content.ValidAsOf, raw, in.Content.OfficialNote).Scan(&created)
+			company = &created
+		} else {
+			// Contributions must not overwrite a different legal entity or scope.
+			tag, e := tx.Exec(r.Context(), `UPDATE company_benefits SET province=$2,industry=$3,valid_as_of=$4,benefits_jsonb=$5,official_note=$6,verified_at=now(),updated_at=now(),revision=revision+1 WHERE id=$1 AND company_name=$7 AND city=$8 AND job_scope=$9 AND status='PUBLISHED'`, *company, in.Content.Province, in.Content.Industry, in.Content.ValidAsOf, raw, in.Content.OfficialNote, in.Content.CompanyName, in.Content.City, in.Content.JobScope)
+			err = e
+			if err == nil && tag.RowsAffected() != 1 {
+				failure(w, r, 409, "COMPANY_CONFLICT", "企业名称、城市及岗位与现有记录不符，请按新记录收录", nil)
+				return
+			}
+		}
+		if err != nil {
+			s.benefitError(w, r, err)
+			return
+		}
+	}
+	raw, _ := json.Marshal(in.Content)
+	audit, _ := r.Context().Value(auditIDKey).(string)
+	_, err = tx.Exec(r.Context(), `INSERT INTO company_benefit_reviews(submission_id,admin_id,audit_id,decision,reason,content_jsonb) VALUES($1,$2,$3,$4,$5,$6)`, id, principal(r.Context()).ID, audit, in.Decision, in.Reason, raw)
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	_, err = tx.Exec(r.Context(), `UPDATE company_benefit_submissions SET status=$2,company_id=$3,review_reason=$4,reviewed_at=now(),updated_at=now(),revision=revision+1 WHERE id=$1`, id, in.Decision, company, in.Reason)
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	title := map[string]string{"APPROVED": "企业福利已收录", "NEEDS_MORE": "企业福利收录需要补充材料", "REJECTED": "企业福利收录审核结果"}[in.Decision]
+	payload, _ := json.Marshal(map[string]any{"title": title, "body": in.Reason, "submission_id": id})
+	_, err = tx.Exec(r.Context(), `INSERT INTO notifications(user_id,type,subject_type,subject_id,payload_safe_jsonb) VALUES($1,'SYSTEM_NOTIFICATION','COMPANY_BENEFIT_SUBMISSION',$2,$3)`, owner, id, payload)
+	if err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	if err = tx.Commit(r.Context()); err != nil {
+		s.benefitError(w, r, err)
+		return
+	}
+	success(w, r, 200, map[string]any{"id": id, "status": in.Decision, "company_id": company})
+}
+
+func decodeBenefitJSON(w http.ResponseWriter, r *http.Request, dst any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 64<<10)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(dst); err != nil {
+		return err
+	}
+	var extra any
+	if err := dec.Decode(&extra); err != io.EOF {
+		return errors.New("multiple JSON values")
+	}
+	return nil
+}
