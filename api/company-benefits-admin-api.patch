+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/fengzijian/bojian-admin-backend/internal/identity"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"log/slog"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func benefitTestDB(t *testing.T) *pgxpool.Pool {
+	t.Helper()
+	dsn := os.Getenv("BENEFITS_TEST_DATABASE_URL")
+	if dsn == "" {
+		t.Skip("isolated local database required")
+	}
+	u, e := url.Parse(dsn)
+	if e != nil || u.Hostname() != "127.0.0.1" {
+		t.Fatal("local database required")
+	}
+	ctx := context.Background()
+	root, e := pgxpool.New(ctx, dsn)
+	if e != nil {
+		t.Fatal(e)
+	}
+	schema := fmt.Sprintf("benefits_%d", time.Now().UnixNano())
+	if _, e = root.Exec(ctx, "CREATE SCHEMA "+schema); e != nil {
+		t.Fatal(e)
+	}
+	cfg, _ := pgxpool.ParseConfig(dsn)
+	cfg.ConnConfig.RuntimeParams["search_path"] = schema
+	db, e := pgxpool.NewWithConfig(ctx, cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { db.Close(); root.Exec(ctx, "DROP SCHEMA "+schema+" CASCADE"); root.Close() })
