+ updated_at timestamptz NOT NULL DEFAULT now(),
+ reviewed_at timestamptz,
+ UNIQUE(user_id,request_key)
+);
+CREATE INDEX company_benefit_submissions_owner_idx ON company_benefit_submissions(user_id,id DESC);
