+func TestOfficialBenefitsReview(t *testing.T) {
+	db := benefitTestDB(t)
+	access, e := identity.New(strings.Repeat("x", 32), "https://private.example.com", "ak", "sk")
+	if e != nil {
+		t.Fatal(e)
+	}
+	s := &Server{db: db, logger: slog.Default(), evidence: access}
+	ctx := context.Background()
+	raw, _ := json.Marshal(testBenefitContent())
+	_, e = db.Exec(ctx, `INSERT INTO company_benefit_submissions(user_id,content_jsonb,employment_file_ids,evidence_file_ids,request_key,request_hash) VALUES(1,$1,ARRAY[11]::bigint[],ARRAY[12]::bigint[],'test-request-key','hash')`, raw)
+	if e != nil {
+		t.Fatal(e)
+	}
+	call := func(decision string, rev int, want int) {
+		t.Helper()
+		body, _ := json.Marshal(map[string]any{"decision": decision, "reason": "隔离测试审核说明", "revision": rev, "content": testBenefitContent()})
+		r := httptest.NewRequest("POST", "/admin/v1/company-benefit-submissions/1/decision", strings.NewReader(string(body)))
+		r.SetPathValue("id", "1")
+		r = r.WithContext(context.WithValue(r.Context(), principalKey, Principal{ID: 1}))
+		w := httptest.NewRecorder()
+		s.adminDecideBenefit(w, r)
+		if w.Code != want {
+			t.Fatalf("%s got %d want %d: %s", decision, w.Code, want, w.Body.String())
+		}
+	}
+	call("APPROVED", 2, 409)
+	call("NEEDS_MORE", 1, 200)
+	call("APPROVED", 2, 409)
+	db.Exec(ctx, `UPDATE company_benefit_submissions SET status='PENDING',revision=3 WHERE id=1`)
+	call("APPROVED", 3, 200)
+	call("APPROVED", 3, 409)
+	var n int
+	db.QueryRow(ctx, `SELECT count(*) FROM company_benefits`).Scan(&n)
+	if n != 1 {
+		t.Fatal("official publication count")
+	}
+	db.QueryRow(ctx, `SELECT count(*) FROM notifications WHERE subject_type='COMPANY_BENEFIT_SUBMISSION'`).Scan(&n)
+	if n != 2 {
+		t.Fatal("review notifications not atomic")
+	}
+	var status string
+	db.QueryRow(ctx, `SELECT status FROM company_benefit_submissions WHERE id=1`).Scan(&status)
+	if status != "APPROVED" {
+		t.Fatal("review state")
+	}
+	r := httptest.NewRequest("GET", "/admin/v1/company-benefit-submissions/1", nil)
+	r.SetPathValue("id", "1")
+	w := httptest.NewRecorder()
+	s.adminBenefitSubmission(w, r)
+	if w.Code != 200 || !strings.Contains(w.Body.String(), "token=") || w.Header().Get("Cache-Control") != "no-store" {
+		t.Fatalf("audited evidence read: %s", w.Body.String())
+	}
+}
