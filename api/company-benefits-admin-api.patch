+package httpapi
+
+import (
+	"errors"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+type benefitContent struct {
+	CompanyName  string            `json:"company_name"`
+	Province     string            `json:"province"`
+	City         string            `json:"city"`
+	Industry     string            `json:"industry"`
+	JobScope     string            `json:"job_scope"`
+	ValidAsOf    string            `json:"valid_as_of"`
+	Benefits     map[string]string `json:"benefits"`
+	OfficialNote string            `json:"official_note"`
+}
+
+var benefitCategories = map[string]bool{"salary": true, "insurance": true, "hours": true, "leave": true, "bonus": true, "allowance": true, "growth": true, "other": true}
+
+func (in *benefitContent) validate() error {
+	in.CompanyName = strings.TrimSpace(in.CompanyName)
+	in.Province = strings.TrimSpace(in.Province)
+	in.City = strings.TrimSpace(in.City)
+	in.Industry = strings.TrimSpace(in.Industry)
+	in.JobScope = strings.TrimSpace(in.JobScope)
+	in.OfficialNote = strings.TrimSpace(in.OfficialNote)
+	for _, field := range []struct {
+		value    string
+		min, max int
+	}{{in.CompanyName, 2, 120}, {in.Province, 1, 40}, {in.City, 1, 40}, {in.Industry, 0, 60}, {in.JobScope, 1, 100}, {in.OfficialNote, 0, 1500}} {
+		n := utf8.RuneCountInString(field.value)
+		if n < field.min || n > field.max {
+			return errors.New("请填写完整的企业名称、地区和适用岗位，内容不要超过字数限制")
+		}
+	}
+	if _, err := time.Parse(time.DateOnly, in.ValidAsOf); err != nil {
+		return errors.New("请填写待遇对应日期（YYYY-MM-DD）")
+	}
+	if len(in.Benefits) == 0 || len(in.Benefits) > 8 {
+		return errors.New("请至少填写一项福利待遇")
+	}
+	for key, value := range in.Benefits {
+		value = strings.TrimSpace(value)
+		if !benefitCategories[key] || value == "" || utf8.RuneCountInString(value) > 2000 {
+			return errors.New("福利内容无效，每项最多2000字")
+		}
+		in.Benefits[key] = value
+	}
+	return nil
+}
