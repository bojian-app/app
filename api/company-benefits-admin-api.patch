+CREATE TABLE company_benefit_reviews (
+ id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+ submission_id bigint NOT NULL REFERENCES company_benefit_submissions(id),
+ admin_id bigint NOT NULL REFERENCES admin_principals(id),
+ audit_id text NOT NULL,
+ decision text NOT NULL,
+ reason text NOT NULL,
+ content_jsonb jsonb NOT NULL DEFAULT '{}'::jsonb,
+ created_at timestamptz NOT NULL DEFAULT now()
+);
