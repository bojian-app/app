+package httpapi
+
+import (
+	"encoding/json"
+	"time"
+)
+
+const benefitPublicColumns = `id,company_name,province,city,industry,job_scope,valid_as_of::text,benefits_jsonb,official_note,revision,verified_at`
+
+func scanBenefit(row interface{ Scan(...any) error }) (map[string]any, error) {
+	var id, revision int64
+	var content benefitContent
+	var raw []byte
+	var verified time.Time
+	err := row.Scan(&id, &content.CompanyName, &content.Province, &content.City, &content.Industry, &content.JobScope, &content.ValidAsOf, &raw, &content.OfficialNote, &revision, &verified)
+	if err != nil {
+		return nil, err
+	}
+	if err = json.Unmarshal(raw, &content.Benefits); err != nil {
+		return nil, err
+	}
+	return map[string]any{"id": id, "content": content, "revision": revision, "verified_at": verified}, nil
+}
+
+const benefitSubmissionColumns = `id,company_id,content_jsonb,employment_file_ids,evidence_file_ids,status,review_reason,revision,created_at,updated_at`
+
+func scanBenefitSubmission(row interface{ Scan(...any) error }) (map[string]any, error) {
+	var id, revision int64
+	var company *int64
+	var raw []byte
+	var proof, evidence []int64
+	var status, reason string
+	var created, updated time.Time
+	err := row.Scan(&id, &company, &raw, &proof, &evidence, &status, &reason, &revision, &created, &updated)
+	if err != nil {
+		return nil, err
+	}
+	var content benefitContent
+	if err = json.Unmarshal(raw, &content); err != nil {
+		return nil, err
+	}
+	return map[string]any{"id": id, "company_id": company, "content": content, "employment_file_ids": proof, "evidence_file_ids": evidence, "status": status, "review_reason": reason, "revision": revision, "created_at": created, "updated_at": updated}, nil
+}
