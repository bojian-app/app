+package httpapi
+
+import "encoding/json"
+
+const importPhotoField = "__import_photo_file_id"
+
+func importedPhotoID(content json.RawMessage) int64 {
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(content, &fields) != nil {
+		return 0
+	}
+	var id int64
+	if json.Unmarshal(fields[importPhotoField], &id) != nil || id <= 0 {
+		return 0
+	}
+	return id
+}
+
+func withoutImportPhoto(content json.RawMessage) json.RawMessage {
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(content, &fields) != nil {
+		return content
+	}
+	delete(fields, importPhotoField)
+	clean, err := json.Marshal(fields)
+	if err != nil {
+		return content
+	}
+	return clean
+}
