+package jobs
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"image"
+	"io"
+	"path/filepath"
+	"strings"
+
+	"github.com/jackc/pgx/v5"
+)
+
+const importPhotoField = "__import_photo_file_id"
+
+// Preserve a single unambiguous portrait image from the original Word package.
+// Multiple plausible images are left for the user to choose rather than guessed.
+func extractDOCXPortrait(filename string) ([]byte, error) {
+	if !strings.EqualFold(filepath.Ext(filename), ".docx") {
+		return nil, nil
+	}
+	archive, err := zip.OpenReader(filename)
+	if err != nil {
+		return nil, err
+	}
+	defer archive.Close()
+	var portrait []byte
+	seen := map[[32]byte]bool{}
+	for _, entry := range archive.File {
+		if !strings.HasPrefix(entry.Name, "word/media/") || entry.UncompressedSize64 > 5<<20 {
+			continue
+		}
+		r, err := entry.Open()
+		if err != nil {
+			return nil, err
+		}
+		data, err := io.ReadAll(io.LimitReader(r, (5<<20)+1))
+		r.Close()
+		if err != nil {
+			return nil, err
+		}
+		if len(data) > 5<<20 {
+			continue
+		}
+		cfg, _, err := image.DecodeConfig(bytes.NewReader(data))
+		if err != nil || cfg.Width < 80 || cfg.Height < 80 || cfg.Width > cfg.Height || cfg.Width*2 < cfg.Height {
+			continue
+		}
+		sum := sha256.Sum256(data)
+		if seen[sum] {
+			continue
+		}
+		seen[sum] = true
+		data, err = normalizeExportPhoto(data)
+		if err != nil || len(data) > 5<<20 {
+			continue
+		}
+		if portrait != nil {
+			return nil, nil
+		}
+		portrait = data
+	}
+	return portrait, nil
+}
+
+func (w *Worker) completeResumeImport(ctx context.Context, job importJob, parsed json.RawMessage, text string, photo []byte) error {
+	var content map[string]any
+	if err := json.Unmarshal(parsed, &content); err != nil {
+		return err
+	}
+	delete(content, importPhotoField)
+	key := ""
+	cleanup := false
+	if len(photo) > 0 {
+		var err error
+		key, err = w.objects.ObjectKey(job.OwnerID, "RESUME_PHOTO", fmt.Sprintf("import-%d-portrait.png", job.ID))
+		if err != nil {
+			return err
+		}
+		_, err = w.db.Exec(ctx, `INSERT INTO object_cleanup_jobs(object_key,next_attempt_at) VALUES($1,now()+interval '24 hours') ON CONFLICT(object_key) DO UPDATE SET next_attempt_at=EXCLUDED.next_attempt_at,last_error='',updated_at=now()`, key)
+		if err != nil {
+			return err
+		}
+		cleanup = true
+		defer func() {
+			if cleanup {
+				w.deleteExportObject(key)
+			}
+		}()
+		if err = w.objects.Put(ctx, key, "image/png", bytes.NewReader(photo)); err != nil {
+			return err
+		}
+	}
+	tx, err := w.db.Begin(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(ctx)
+	if len(photo) > 0 {
+		sum := sha256.Sum256(photo)
+		var id int64
+		err = tx.QueryRow(ctx, `INSERT INTO files(owner_id,purpose,object_key,original_name,content_type,size_bytes,sha256,status,completed_at) VALUES($1,'RESUME_PHOTO',$2,'imported-portrait.png','image/png',$3,$4,'READY',now()) RETURNING id`, job.OwnerID, key, len(photo), hex.EncodeToString(sum[:])).Scan(&id)
+		if err != nil {
+			return err
+		}
+		content[importPhotoField] = id
+	}
+	parsed, err = json.Marshal(content)
+	if err != nil {
+		return err
+	}
+	command, err := tx.Exec(ctx, `UPDATE resume_imports SET status='WAITING_CONFIRMATION',parsed_content_jsonb=$1,unresolved_source_text=$2,worker_id=NULL,lease_expires_at=NULL,updated_at=now() WHERE id=$3 AND worker_id=$4 AND status='RUNNING' AND lease_expires_at>now()`, parsed, text, job.ID, w.workerID)
+	if err = updateOwned(command, err); err != nil {
+		return err
+	}
+	if key != "" {
+		if _, err = tx.Exec(ctx, `DELETE FROM object_cleanup_jobs WHERE object_key=$1`, key); err != nil {
+			return err
+		}
+	}
+	if err = tx.Commit(ctx); err != nil {
+		if !errors.Is(err, pgx.ErrTxCommitRollback) {
+			cleanup = false
+		}
+		return err
+	}
+	cleanup = false
+	return nil
+}
