+	server.getResumeImport(previewOut, preview)
+	if previewOut.Code != 200 || !strings.Contains(previewOut.Body.String(), "https://cdn.example.test/portrait.png") || strings.Contains(previewOut.Body.String(), importPhotoField) {
+		t.Fatalf("portrait preview failed: %s", previewOut.Body.String())
+	}
+
+	for _, tc := range []struct {
+		id   string
+		want *int64
+	}{{"1", func() *int64 { v := int64(42); return &v }()}, {"2", nil}, {"3", nil}} {
+		r := httptest.NewRequest("POST", "/", strings.NewReader(`{"content":{"personal_info":{"full_name":"Name"},"__import_photo_file_id":99}}`))
+		r.SetPathValue("id", tc.id)
+		r = r.WithContext(context.WithValue(ctx, userIDKey, int64(1)))
+		out := httptest.NewRecorder()
+		server.confirmResumeImport(out, r)
+		if out.Code != 201 {
+			t.Fatalf("confirm %s: %d %s", tc.id, out.Code, out.Body.String())
+		}
+		var envelope struct {
+			Data struct {
+				ID int64 `json:"resume_id"`
+			} `json:"data"`
+		}
+		if err = json.Unmarshal(out.Body.Bytes(), &envelope); err != nil {
+			t.Fatal(err)
+		}
+		var photo *int64
+		var content []byte
+		if err = db.QueryRow(ctx, "SELECT photo_file_id,content_jsonb FROM resumes WHERE id=$1", envelope.Data.ID).Scan(&photo, &content); err != nil {
+			t.Fatal(err)
+		}
+		if (photo == nil) != (tc.want == nil) || (photo != nil && *photo != *tc.want) {
+			t.Fatal("untrusted or missing portrait")
+		}
+		if strings.Contains(string(content), importPhotoField) {
+			t.Fatal("metadata retained in saved content")
+		}
+		// Repeating confirmation must return the same resume rather than lose its photo.
+		r = httptest.NewRequest("POST", "/", strings.NewReader(`{"content":{}}`))
+		r.SetPathValue("id", tc.id)
+		r = r.WithContext(context.WithValue(ctx, userIDKey, int64(1)))
+		out = httptest.NewRecorder()
+		server.confirmResumeImport(out, r)
+		if out.Code != 200 {
+			t.Fatal("confirmation is not idempotent")
+		}
+	}
+}
