+	"testing"
+)
+
+func TestDOCXPortraitExtraction(t *testing.T) {
+	portrait := func(w, h int) []byte {
+		var b bytes.Buffer
+		if err := png.Encode(&b, image.NewRGBA(image.Rect(0, 0, w, h))); err != nil {
+			t.Fatal(err)
+		}
+		return b.Bytes()
+	}
+	for _, test := range []struct {
+		name   string
+		images map[string][]byte
+		want   bool
+	}{
+		{"portrait", map[string][]byte{"word/media/image1.png": portrait(180, 240)}, true},
+		{"no_picture", nil, false},
+		{"decoration", map[string][]byte{"word/media/banner.png": portrait(400, 100)}, false},
+		{"ambiguous", map[string][]byte{"word/media/a.png": portrait(180, 240), "word/media/b.png": portrait(160, 240)}, false},
+		{"duplicate", map[string][]byte{"word/media/a.png": portrait(180, 240), "word/media/b.png": portrait(180, 240)}, true},
+		{"unrelated_part", map[string][]byte{"customXml/a.png": portrait(180, 240)}, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			filename := filepath.Join(t.TempDir(), "resume.docx")
+			f, err := os.Create(filename)
+			if err != nil {
+				t.Fatal(err)
+			}
+			z := zip.NewWriter(f)
+			for name, data := range test.images {
+				w, err := z.Create(name)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err = w.Write(data); err != nil {
+					t.Fatal(err)
+				}
+			}
+			z.Close()
+			f.Close()
+			got, err := extractDOCXPortrait(filename)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if (len(got) > 0) != test.want {
+				t.Fatalf("portrait presence=%v", len(got) > 0)
+			}
+			if test.want {
+				cfg, format, err := image.DecodeConfig(bytes.NewReader(got))
+				if err != nil || format != "png" || cfg.Width != 180 || cfg.Height != 240 {
+					t.Fatal("portrait was not preserved")
+				}
+			}
+		})
+	}
+}
