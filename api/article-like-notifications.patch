+-- One notification per author, liker and article. Repeated requests and
+-- unlike/re-like must not flood the recipient's inbox.
+CREATE UNIQUE INDEX article_like_notification_once
+ON notifications(user_id,actor_id,subject_id)
+WHERE type='ARTICLE_LIKE' AND subject_type='ARTICLE';
+
+CREATE FUNCTION notify_article_like(article_id bigint, liker_id bigint, liked_at timestamptz)
+RETURNS void LANGUAGE plpgsql AS $$
+BEGIN
+    INSERT INTO notifications(user_id,type,actor_id,subject_type,subject_id,payload_safe_jsonb,created_at)
+    SELECT p.author_id,'ARTICLE_LIKE',liker_id,'ARTICLE',p.id,
+        jsonb_build_object('title','收到新的赞',
+            'body',COALESCE(NULLIF(btrim(actor.nickname),''),'用户') || '赞了你的文章《' || p.title || '》'),
+        liked_at
+    FROM posts p
+    JOIN users owner ON owner.id=p.author_id AND owner.status='ACTIVE' AND owner.deleted_at IS NULL
+    JOIN users actor ON actor.id=liker_id AND actor.status='ACTIVE' AND actor.deleted_at IS NULL
+    WHERE p.id=article_id AND p.author_id<>liker_id AND p.status='PUBLISHED' AND p.deleted_at IS NULL
+      AND NOT EXISTS(SELECT 1 FROM user_blocks b
+        WHERE (b.blocker_id=liker_id AND b.blocked_id=p.author_id)
+           OR (b.blocker_id=p.author_id AND b.blocked_id=liker_id))
+    ON CONFLICT DO NOTHING;
+END;
+$$;
+
+CREATE FUNCTION article_like_notification_inserted() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    PERFORM notify_article_like(NEW.post_id,NEW.user_id,NEW.created_at);
+    RETURN NEW;
+END;
+$$;
+CREATE TRIGGER notify_article_like_insert
+AFTER INSERT ON post_likes FOR EACH ROW EXECUTE FUNCTION article_like_notification_inserted();
+
+-- Repair existing missed notifications from actual likes, preserving the
+-- original action time. The notification trigger creates durable realtime events.
+DO $$
+DECLARE existing record;
+BEGIN
+    FOR existing IN SELECT post_id,user_id,created_at FROM post_likes ORDER BY created_at,id LOOP
+        PERFORM notify_article_like(existing.post_id,existing.user_id,existing.created_at);
+    END LOOP;
+END;
+$$;
