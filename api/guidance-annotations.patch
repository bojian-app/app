+	if len(call(3, "articles", "GET", "", "", "", 200)["items"].([]any)) != 1 {
+		t.Fatal("accepted update missing")
+	}
+	var source, shared []byte
+	var revision int
+	db.QueryRow(ctx, `SELECT content_jsonb,revision FROM resumes WHERE id=10`).Scan(&source, &revision)
+	db.QueryRow(ctx, `SELECT content_jsonb FROM posts WHERE id=20`).Scan(&shared)
+	if revision != 2 || !strings.Contains(string(source), "前端开发与性能优化") || !strings.Contains(string(source), "SECRET") || !strings.Contains(string(source), `"italic": true`) || !strings.Contains(string(shared), "前端开发与性能优化") || strings.Contains(string(shared), "SECRET") || strings.Contains(string(shared), "PRIVATE") {
+		t.Fatalf("invalid acceptance: %s / %s revision %d", source, shared, revision)
+	}
+	// Reject leaves both snapshots untouched; stale author edits cannot be overwritten.
+	body = strings.ReplaceAll(strings.ReplaceAll(body, "负责开发网站", "负责前端开发与性能优化"), `"selected_text":"开发网站"`, `"selected_text":"前端开发与性能优化"`)
+	result = call(2, "articles", "POST", "", body, "replace-2", 200)
+	aid = fmt.Sprintf("%.0f", result["id"])
+	call(1, "articles", "POST", "/"+aid+"/decision", `{"status":"REJECTED"}`, "", 200)
+	result = call(2, "articles", "POST", "", body, "replace-3", 200)
+	aid = fmt.Sprintf("%.0f", result["id"])
+	db.Exec(ctx, `UPDATE resumes SET content_jsonb=jsonb_set(content_jsonb,'{work_experiences,0,description}','"作者已修改"') WHERE id=10`)
+	call(1, "articles", "POST", "/"+aid+"/decision", `{"status":"ACCEPTED"}`, "", 409)
+	// Private invitation uses the same flow, never reveals original privacy fields.
+	db.Exec(ctx, `UPDATE resumes SET content_jsonb=jsonb_set(content_jsonb,'{work_experiences,0,description}','"负责开发网站"') WHERE id=10;
+ INSERT INTO notifications(id,user_id,type,actor_id,subject_type,subject_id,payload_safe_jsonb) OVERRIDING SYSTEM VALUE VALUES(20,2,'RESUME_GUIDANCE',1,'GUIDANCE_NOTIFICATION',20,'{"guidance":{"source_resume_id":10,"snapshot":{"work_experiences":[{"description":"负责开发网站"}]}}}');`)
+	body = `{"field_path":"work_experiences.0.description","field_value":"负责开发网站","selected_text":"开发网站","replacement":"前端研发"}`
+	result = call(2, "notifications", "POST", "", body, "private-1", 200)
+	aid = fmt.Sprintf("%.0f", result["id"])
+	call(3, "notifications", "GET", "", "", "", 404)
+	call(1, "notifications", "POST", "/"+aid+"/decision", `{"status":"ACCEPTED"}`, "", 200)
+	var private []byte
+	db.QueryRow(ctx, `SELECT payload_safe_jsonb FROM notifications WHERE id=20`).Scan(&private)
+	if !strings.Contains(string(private), "前端研发") || strings.Contains(string(private), "SECRET") {
+		t.Fatal("invalid private acceptance")
+	}
+}
