+CREATE TABLE resume_guidance_annotations (
+ id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+ scope varchar(16) NOT NULL CHECK(scope IN ('ARTICLE','NOTIFICATION')),
