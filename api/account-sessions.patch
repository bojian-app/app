+package httpapi
+
+import (
+	"net/http"
+	"time"
+)
+
+func (s *Server) listAccountSessions(w http.ResponseWriter, r *http.Request) {
+	rows, err := s.db.Query(r.Context(), `SELECT id,device_id,platform,app_version,created_at FROM user_sessions WHERE user_id=$1 AND revoked_at IS NULL AND expires_at>now() ORDER BY (id=$2) DESC,created_at DESC,id DESC`, UserID(r.Context()), SessionID(r.Context()))
+	if err != nil {
+		s.internal(w, r, "list account sessions", err)
+		return
+	}
+	defer rows.Close()
+	devices := make([]map[string]any, 0)
+	for rows.Next() {
+		var id int64
+		var device, platform, version string
+		var created time.Time
+		if err = rows.Scan(&id, &device, &platform, &version, &created); err != nil {
+			s.internal(w, r, "read account session", err)
+			return
+		}
+		devices = append(devices, map[string]any{"id": id, "device_id": device, "platform": platform, "app_version": version, "logged_in_at": created.UTC().Format(time.RFC3339), "is_current": id == SessionID(r.Context())})
+	}
+	if err = rows.Err(); err != nil {
+		s.internal(w, r, "read account sessions", err)
+		return
+	}
+	Success(w, r, http.StatusOK, map[string]any{"items": devices})
+}
+
+func (s *Server) revokeAccountSession(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r, "id")
+	if !ok {
+		return
+	}
+	result, err := s.db.Exec(r.Context(), `UPDATE user_sessions SET revoked_at=now(),updated_at=now() WHERE id=$1 AND user_id=$2 AND revoked_at IS NULL`, id, UserID(r.Context()))
+	if err != nil {
+		s.internal(w, r, "revoke account session", err)
+		return
+	}
+	if result.RowsAffected() == 0 {
+		Failure(w, r, http.StatusNotFound, "NOT_FOUND", "登录设备不存在或已退出", nil)
+		return
+	}
+	Success(w, r, http.StatusOK, map[string]any{"revoked": true, "is_current": id == SessionID(r.Context())})
+}
