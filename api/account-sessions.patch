+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"log/slog"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"testing"
+	"time"
+)
+
+func TestAccountSessionIsolation(t *testing.T) {
+	dsn := os.Getenv("ACCOUNT_SESSION_TEST_DATABASE_URL")
+	if dsn == "" {
+		t.Skip("isolated database not configured")
+	}
+	u, err := url.Parse(dsn)
+	if err != nil || (u.Hostname() != "localhost" && u.Hostname() != "127.0.0.1") {
+		t.Fatal("requires isolated local database")
+	}
+	ctx := context.Background()
+	admin, err := pgxpool.New(ctx, dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Close()
+	schema := fmt.Sprintf("account_session_test_%d", time.Now().UnixNano())
+	if _, err = admin.Exec(ctx, "CREATE SCHEMA "+schema); err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Exec(ctx, "DROP SCHEMA "+schema+" CASCADE")
+	cfg, err := pgxpool.ParseConfig(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.ConnConfig.RuntimeParams["search_path"] = schema
+	db, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(ctx, `CREATE TABLE user_sessions(id bigint PRIMARY KEY,user_id bigint,device_id text,platform text,app_version text,created_at timestamptz,updated_at timestamptz,revoked_at timestamptz,expires_at timestamptz);
+ INSERT INTO user_sessions VALUES
+ (1,1,'phone','ANDROID','1.0.0',now(),now(),NULL,now()+interval '1 day'),
+ (2,1,'desktop','MACOS','1.0.0',now(),now(),NULL,now()+interval '1 day'),
+ (3,2,'other-user','IOS','1.0.0',now(),now(),NULL,now()+interval '1 day'),
+ (4,1,'expired','IOS','1.0.0',now(),now(),NULL,now()-interval '1 day'),
+ (5,1,'revoked','IOS','1.0.0',now(),now(),now(),now()+interval '1 day');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &Server{db: db, logger: slog.Default()}
+	authCtx := context.WithValue(context.WithValue(ctx, userIDKey, int64(1)), sessionIDKey, int64(1))
+	list := func() []map[string]any {
+		t.Helper()
+		w := httptest.NewRecorder()
+		r := httptest.NewRequest("GET", "/api/v1/me/sessions", nil).WithContext(authCtx)
+		s.listAccountSessions(w, r)
+		if w.Code != 200 {
+			t.Fatalf("list failed: %s", w.Body.String())
+		}
+		var response struct {
+			Data struct {
+				Items []map[string]any `json:"items"`
+			} `json:"data"`
+		}
+		if err = json.Unmarshal(w.Body.Bytes(), &response); err != nil {
+			t.Fatal(err)
+		}
+		return response.Data.Items
+	}
+	entries := list()
+	if len(entries) != 2 || entries[0]["is_current"] != true {
+		t.Fatalf("unexpected sessions: %#v", entries)
+	}
+	revoke := func(id string, status int) {
+		t.Helper()
+		w := httptest.NewRecorder()
+		r := httptest.NewRequest("DELETE", "/api/v1/me/sessions/"+id, nil).WithContext(authCtx)
+		r.SetPathValue("id", id)
+		s.revokeAccountSession(w, r)
+		if w.Code != status {
+			t.Fatalf("revoke %s expected %d got %d: %s", id, status, w.Code, w.Body.String())
+		}
+	}
+	revoke("invalid", 400)
+	revoke("3", 404)
+	revoke("2", 200)
+	revoke("2", 404)
+	entries = list()
+	if len(entries) != 1 || entries[0]["id"] != float64(1) {
+		t.Fatalf("wrong device removed: %#v", entries)
+	}
+	var otherActive bool
+	if err = db.QueryRow(ctx, `SELECT revoked_at IS NULL FROM user_sessions WHERE id=3`).Scan(&otherActive); err != nil || !otherActive {
+		t.Fatal("another user's session changed")
+	}
+	revoke("1", 200)
+	if len(list()) != 0 {
+		t.Fatal("current session still listed")
+	}
+}
