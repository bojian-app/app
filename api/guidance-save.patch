@@ -0,0 +1,158 @@
+package httpapi
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+	"strings"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Saving is the only operation in the review draft flow that creates a resume.
+func (s *Server) saveGuidanceAnnotations(w http.ResponseWriter, r *http.Request, tx pgx.Tx, id int64, share annotationShare, ids []int64, anchor int64) {
+	if len(ids) == 0 || len(ids) > 50 {
+		Failure(w, r, 422, "INVALID_ARGUMENT", "一次最多保存 50 条修改建议", nil)
+		return
+	}
+	unique := map[int64]bool{}
+	for _, aid := range ids {
+		if aid <= 0 || unique[aid] {
+			Failure(w, r, 422, "INVALID_ARGUMENT", "修改建议列表无效", nil)
+			return
+		}
+		unique[aid] = true
+	}
+	if !unique[anchor] {
+		Failure(w, r, 422, "INVALID_ARGUMENT", "修改建议列表无效", nil)
+		return
+	}
+	var sourceRaw []byte
+	if err := tx.QueryRow(r.Context(), `SELECT content_jsonb FROM resumes WHERE id=$1 AND owner_id=$2 AND deleted_at IS NULL FOR UPDATE`, share.resume, share.owner).Scan(&sourceRaw); err != nil {
+		Failure(w, r, 404, "NOT_FOUND", "原简历不存在", nil)
+		return
+	}
+	refreshed, err := s.annotationAccess(r, tx, id, true)
+	if err != nil || refreshed.owner != UserID(r.Context()) || refreshed.resume != share.resume {
+		Failure(w, r, 409, "SHARE_CHANGED", "分享内容已变化，请重新打开", nil)
+		return
+	}
+	share = refreshed
+	type edit struct {
+		id                                       int64
+		path, old, selected, replacement, status string
+		result                                   *int64
+		start                                    int
+	}
+	rows, err := tx.Query(r.Context(), `SELECT id,field_path,field_value,selected_text,replacement,status,result_resume_id FROM resume_guidance_annotations WHERE scope=$1 AND share_id=$2 AND id=ANY($3) ORDER BY id FOR UPDATE`, share.scope(), id, ids)
+	if err != nil {
+		s.internal(w, r, "review save read", err)
+		return
+	}
+	edits := []edit{}
+	for rows.Next() {
+		var e edit
+		if err = rows.Scan(&e.id, &e.path, &e.old, &e.selected, &e.replacement, &e.status, &e.result); err != nil {
+			break
+		}
+		edits = append(edits, e)
+	}
+	if err == nil {
+		err = rows.Err()
+	}
+	rows.Close()
+	if err != nil {
+		s.internal(w, r, "review save scan", err)
+		return
+	}
+	if len(edits) != len(ids) {
+		Failure(w, r, 404, "NOT_FOUND", "部分修改建议已不存在", nil)
+		return
+	}
+	// Repeated save returns the same generated resume, including after a lost response.
+	repeated := true
+	var existing int64
+	for _, e := range edits {
+		if e.status != "ACCEPTED" || e.result == nil {
+			repeated = false
+			break
+		}
+		if existing == 0 {
+			existing = *e.result
+		}
+		if *e.result != existing {
+			repeated = false
+			break
+		}
+	}
+	if repeated {
+		Success(w, r, 200, map[string]any{"status": "ACCEPTED", "result_resume_id": existing, "deduplicated": true})
+		return
+	}
+	var source map[string]any
+	if err = json.Unmarshal(sourceRaw, &source); err != nil {
+		s.internal(w, r, "review save source", err)
+		return
+	}
+	snapshot, _ := share.content["snapshot"].(map[string]any)
+	for i := range edits {
+		e := &edits[i]
+		original, key, ok := annotationField(source, e.path)
+		shared, sharedKey, valid := annotationField(snapshot, e.path)
+		if e.status != "PENDING" || e.replacement == "" || !ok || !valid || original[key] != e.old || shared[sharedKey] != e.old || strings.Count(e.old, e.selected) != 1 {
+			Failure(w, r, 409, "SELECTION_CHANGED", "部分内容已变化，请重新核对修改建议", nil)
+			return
+		}
+		e.start = strings.Index(e.old, e.selected)
+	}
+	sort.Slice(edits, func(i, j int) bool {
+		if edits[i].path != edits[j].path {
+			return edits[i].path < edits[j].path
+		}
+		return edits[i].start > edits[j].start
+	})
+	for i := 1; i < len(edits); i++ {
+		a, b := edits[i-1], edits[i]
+		if a.path == b.path && b.start+len(b.selected) > a.start {
+			Failure(w, r, 409, "OVERLAPPING_SUGGESTIONS", "同一处有重叠建议，请选择一种修改", nil)
+			return
+		}
+	}
+	for _, e := range edits {
+		original, key, _ := annotationField(source, e.path)
+		shared, sharedKey, _ := annotationField(snapshot, e.path)
+		replaceAnnotationField(original, key, e.selected, e.replacement)
+		replaceAnnotationField(shared, sharedKey, e.selected, e.replacement)
+	}
+	raw, _ := json.Marshal(source)
+	var newID int64
+	err = tx.QueryRow(r.Context(), `INSERT INTO resumes(owner_id,template_id,title,content_jsonb,photo_file_id,photo_crop,checksum) SELECT owner_id,template_id,regexp_replace(title,' · 指点修改版$','') || ' · 指点修改版',$1,photo_file_id,photo_crop,$2 FROM resumes WHERE id=$3 RETURNING id`, raw, fmt.Sprintf("%x", sha256.Sum256(raw)), share.resume).Scan(&newID)
+	if err != nil {
+		s.internal(w, r, "review save copy", err)
+		return
+	}
+	if share.content["original_resume_id"] == nil {
+		share.content["original_resume_id"] = share.resume
+	}
+	share.content["source_resume_id"] = newID
+	if share.notification {
+		raw, _ = json.Marshal(share.payload)
+		_, err = tx.Exec(r.Context(), `UPDATE notifications SET payload_safe_jsonb=$2 WHERE id=$1`, id, raw)
+	} else {
+		raw, _ = json.Marshal(share.content)
+		_, err = tx.Exec(r.Context(), `UPDATE posts SET content_jsonb=$2,revision=revision+1 WHERE id=$1`, id, raw)
+	}
+	if err == nil {
+		_, err = tx.Exec(r.Context(), `UPDATE resume_guidance_annotations SET status='ACCEPTED',decided_at=now(),result_resume_id=$2 WHERE id=ANY($1)`, ids, newID)
+	}
+	if err == nil {
+		err = tx.Commit(r.Context())
+	}
+	if err != nil {
+		s.internal(w, r, "review save commit", err)
+		return
+	}
+	Success(w, r, 200, map[string]any{"status": "ACCEPTED", "result_resume_id": newID})
+}
