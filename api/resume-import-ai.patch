+package jobs
+
+import (
+	"context"
+	"encoding/json"
+	"log/slog"
+	"os"
+	"testing"
+	"time"
+	"unicode/utf8"
+)
+
+// Opt-in provider regression: the document and credentials stay outside source control.
+func TestResumeImportAIProvider(t *testing.T) {
+	filename := os.Getenv("BOJIAN_IMPORT_SMOKE_FILE")
+	if filename == "" {
+		t.Skip("set BOJIAN_IMPORT_SMOKE_FILE for a real provider regression")
+	}
+	worker := New(slog.Default(), nil, nil, Options{
+		AIBaseURL: os.Getenv("AI_POLISH_BASE_URL"), AIAPIKey: os.Getenv("AI_POLISH_API_KEY"),
+		AIModel: os.Getenv("AI_POLISH_MODEL"), AITimeout: 120 * time.Second, AIMaxTokens: 4096,
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Minute)
+	defer cancel()
+	text, _, err := worker.callDocumentParser(ctx, filename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if utf8.RuneCountInString(text) < 500 {
+		t.Fatal("document identification lost substantive content")
+	}
+	parsed, _, err := worker.callResumeParser(ctx, text)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var content struct {
+		PersonalInfo struct {
+			FullName string `json:"full_name"`
+		} `json:"personal_info"`
+		Work      []json.RawMessage `json:"work_experiences"`
+		Education []json.RawMessage `json:"educations"`
+		Skills    []json.RawMessage `json:"skills"`
+	}
+	if err := json.Unmarshal(parsed, &content); err != nil {
+		t.Fatal(err)
+	}
+	if content.PersonalInfo.FullName == "" || len(content.Work) == 0 || len(content.Education) == 0 {
+		t.Fatal("AI did not compose the expected resume sections")
+	}
+	t.Logf("AI import passed: characters=%d work_entries=%d education_entries=%d skills=%d", utf8.RuneCountInString(text), len(content.Work), len(content.Education), len(content.Skills))
+}
