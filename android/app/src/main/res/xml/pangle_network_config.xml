<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Ad creatives and third-party landing redirects may use HTTP.
         Bojian API clients continue to require HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
